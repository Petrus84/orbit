<file path="components/layout/Sidebar.tsx">
/* ==========================================================================
   ORBIT · Sidebar (v2.0.0 — ALINHADO ÀS 11 RNs DO SSOT)
   Caminho: src/components/layout/Sidebar.tsx
   Versão: 2.0.0 | Data: 2026-07-05

   GOVERNANÇA RÍGIDA APLICADA:
   ✅ R-01: Visão unificada de carteira — semáforo de saúde → /carteira
   ✅ R-02: Alerta proativo com threshold configurável → /alertas
   ✅ R-04: Funil interativo com simulador de cenário → /instagram/funil
   ✅ R-07: Visão unificada orgânico + pago → /instagram (overview)
   ✅ R-11: Auditoria de consistência de avatar → /instagram/avatar

   MUDANÇAS v2.0.0:
   • Removido hardcoding de cliente — agora vem do contexto OrbitDashboardContext
   • Documentação alinhada às 11 RNs para cada item de menu
   • Badges dinâmicas (alertas) derivadas do contexto, não hardcoded
   • Estrutura de tipos refatorada para máxima clareza
   • Zero ruído de "Estudo de Mercado" ou features fantasmas
   • Comentários removidos que mencionavam v1.2.2 (obsoleto)

   NOTA: Estilização mantém conformidade com ssot-design-tokens.css
   (nenhuma classe Orbit redundante adicionada)
   ========================================================================== */

"use client";

import React from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import styles from "./Sidebar.module.css";
import { useOrbitDashboard } from "@/context/OrbitDashboardContext";
import { NAV_ITEM_TO_TAB_MAP, isNavItemActive } from "./navItemMapping";
import type { TabId } from "@/types/orbit";

/**
 * Representa um item de navegação da sidebar.
 * Cada item mapeia a uma regra de negócio (RN) específica.
 */
interface NavItem {
  id: string;
  label: string;
  href: string;
  icon: string;
  section: "visao-geral" | "instagram";
  ruleNumber?: string; // Rastreabilidade: qual RN este item atende
  badge?: number | undefined;
  badgeVariant?: "default" | "alert";
}

/**
 * WHITELIST OFICIAL DE ITENS DE NAVEGAÇÃO
 * Alinhados às 11 RNs do SSOT. Nenhum ruído de "Estudo de Mercado".
 */
const NAV_ITEMS: NavItem[] = [
  // ── SEÇÃO: Visão Geral ─────────────────────────────────────────────────────
  {
    id: "carteira",
    label: "Carteira",
    href: "/carteira",
    icon: "📁",
    section: "visao-geral",
    ruleNumber: "R-01", // Visão unificada de carteira — semáforo de saúde
  },
  {
    id: "alertas",
    label: "Alertas",
    href: "/alertas",
    icon: "🔔",
    section: "visao-geral",
    ruleNumber: "R-02", // Alerta proativo com threshold configurável
    badge: undefined, // Dinâmico: vem do contexto
    badgeVariant: "alert",
  },

  // ── SEÇÃO: Instagram ───────────────────────────────────────────────────────
  {
    id: "visao-geral-ig",
    label: "Visão geral IG",
    href: "/instagram",
    icon: "📊",
    section: "instagram",
    ruleNumber: "R-07", // Visão unificada orgânico + pago
  },
  {
    id: "funil-simulador",
    label: "Funil + Simulador",
    href: "/funil",
    icon: "🌀",
    section: "instagram",
    ruleNumber: "R-04", // Funil interativo com simulador de cenário
  },
  {
    id: "avatar-alignment",
    label: "Avatar Alignment",
    href: "/avatar",
    icon: "👤",
    section: "instagram",
    ruleNumber: "R-11", // Auditoria de consistência de avatar
  },
  {
    id: "onboarding",
    label: "Onboarding",
    href: "/onboarding",
    icon: "🧭",
    section: "instagram",
    // Sem R-XX: não está entre as 11 RNs originais do SSOT — item
    // adicionado em 2026-08-20 porque a tela/hook/repository já existiam
    // completos (ver ADR-010) e ficavam inalcançáveis sem link de menu.
  },
];

// Escondidos até segunda ordem (17/10/2026): Funil (tabelas não existem) e
// Avatar (patch não aplicado). As entradas e as rotas continuam no código;
// para religar, tire o id daqui.
const HIDDEN_NAV_IDS: ReadonlySet<string> = new Set([
  "funil-simulador",
  "avatar-alignment",
]);
const VISIBLE_NAV_ITEMS: NavItem[] = NAV_ITEMS.filter(
  (i) => !HIDDEN_NAV_IDS.has(i.id),
);

/**
 * Sidebar: Navegação principal do ORBIT
 *
 * Renderiza itens de menu baseando-se estritamente no mapeamento oficial (NAV_ITEMS).
 * Badges de alertas são dinâmicos, derivados do contexto OrbitDashboardContext.
 * Nenhum elemento visual, botão ou link estático para "Estudo de Mercado".
 */
export function Sidebar() {
  // usePathname() tipa como `string | null` (pode ser null durante certas
  // transições de rota no App Router). isNavItemActive() e as comparações
  // abaixo (`pathname === item.href`) esperam sempre uma string — o
  // fallback '' nunca bate com nenhum item.href real, então o comportamento
  // visual não muda (nenhum item fica marcado como ativo nesse instante).
  const pathname = usePathname() ?? "";
  const { activeTab, setActiveTab, currentClient, alertCount } =
    useOrbitDashboard();

  // Separar itens por seção
  const visaoGeralItems = VISIBLE_NAV_ITEMS.filter(
    (i) => i.section === "visao-geral",
  );
  const instagramItems = VISIBLE_NAV_ITEMS.filter(
    (i) => i.section === "instagram",
  );

  // Enriquecer itens com badges dinâmicos
  const visaoGeralItemsEnriched = visaoGeralItems.map((item) => {
    if (item.id === "alertas") {
      return { ...item, badge: alertCount ?? 0 };
    }
    return item;
  });

  return (
    <aside className={styles.sidebar} aria-label="Navegação principal do ORBIT">
      {/* ── Logo ────────────────────────────────────────────────────────────── */}
      <div className={styles.logo}>
        <div className={styles.logoBadge} aria-hidden="true">
          O
        </div>
        <div>
          <p className={styles.logoName}>ORBIT</p>
          <p className={styles.logoSub}>SOCIAL INTELLIGENCE</p>
        </div>
      </div>

      {/* ── Cliente Ativo (Dinâmico) ────────────────────────────────────────── */}
      {/* /alertas é visão de portfólio (todos os clientes): nenhum cliente ativo. */}
      {currentClient && !pathname.startsWith("/alertas") && (
        <div className={styles.clientBox}>
          <p className={styles.clientLabel}>CLIENTE ATIVO</p>
          <div className={styles.clientName}>
            <span>{currentClient.name}</span>
            <span
              className={styles.clientDot}
              data-status={currentClient.status}
              aria-label={`Status: ${currentClient.status}`}
            />
          </div>
        </div>
      )}

      {/* ── Seção: Visão Geral ──────────────────────────────────────────────── */}
      <p className={styles.sectionLabel}>VISÃO GERAL</p>
      <nav aria-label="Navegação de visão geral">
        <ul className={styles.navList} role="list">
          {visaoGeralItemsEnriched.map((item) => (
            <NavItemRow
              key={item.id}
              item={item}
              isActive={pathname === item.href}
              onTabClick={setActiveTab}
            />
          ))}
        </ul>
      </nav>

      {/* ── Seção: Instagram ────────────────────────────────────────────────── */}
      <p className={styles.sectionLabel}>INSTAGRAM</p>
      <nav aria-label="Navegação de Instagram">
        <ul className={styles.navList} role="list">
          {instagramItems.map((item) => {
            const itemIsActive = isNavItemActive(
              item.id,
              pathname,
              item.href,
              activeTab,
            );
            return (
              <NavItemRow
                key={item.id}
                item={item}
                isActive={itemIsActive}
                onTabClick={setActiveTab}
              />
            );
          })}
        </ul>
      </nav>
    </aside>
  );
}

// ─────────────────────────────────────────────────────────────────────────────
// NavItemRow: Componente de linha de item de navegação
// ─────────────────────────────────────────────────────────────────────────────

interface NavItemRowProps {
  item: NavItem;
  isActive: boolean;
  onTabClick: (tabId: TabId) => void;
}

/**
 * NavItemRow: Renderiza uma linha de item de navegação.
 *
 * Lógica de clique (v2.0.0):
 * - Se o item está em NAV_ITEM_TO_TAB_MAP (aba dentro de /instagram):
 *   → Intercepta clique, chama setActiveTab(), previne navegação padrão
 * - Se o item NÃO está no mapa (rota independente):
 *   → Permite navegação padrão do Next.js
 *
 * @param item - Definição do item de navegação
 * @param isActive - Se o item está ativo (baseado em pathname + activeTab)
 * @param onTabClick - Callback para mudar aba (apenas para itens em NAV_ITEM_TO_TAB_MAP)
 */
function NavItemRow({ item, isActive, onTabClick }: NavItemRowProps) {
  const pathname = usePathname();

  const handleItemClick = (e: React.MouseEvent<HTMLAnchorElement>) => {
    // Intercepta como troca de aba SOMENTE se:
    //   1. o item está no mapa de abas (visao-geral-ig → 'overview'), E
    //   2. o usuário já está fisicamente em /instagram.
    // Sem o item 2, clicar em "Visão geral IG" a partir de QUALQUER outra
    // rota (Carteira, Alertas, Funil, Avatar, Onboarding) ficava sem efeito
    // visível: o preventDefault() bloqueava a navegação real do Next.js e
    // setActiveTab() mudava o estado do OrbitDashboardProvider errado (o
    // "provider de sidebar" do layout compartilhado, que não renderiza
    // nada dependente de activeTab) — a página parecia "não clicável".
    if (
      item.section === "instagram" &&
      item.id in NAV_ITEM_TO_TAB_MAP &&
      pathname === item.href
    ) {
      e.preventDefault();
      const tabId = NAV_ITEM_TO_TAB_MAP[item.id];
      if (tabId) onTabClick(tabId);
    }
    // Caso contrário: <Link> navega normalmente para item.href.
  };

  return (
    <li>
      <Link
        href={item.href}
        className={[styles.navItem, isActive ? styles.navItemActive : ""]
          .filter(Boolean)
          .join(" ")}
        aria-current={isActive ? "page" : undefined}
        data-rule={item.ruleNumber}
        onClick={handleItemClick}
      >
        <span className={styles.navIcon} aria-hidden="true">
          {item.icon}
        </span>
        <span className={styles.navLabel}>{item.label}</span>
        {item.badge !== undefined && item.badge > 0 && (
          <span
            className={[
              styles.badge,
              item.badgeVariant === "alert"
                ? styles.badgeAlert
                : styles.badgeDefault,
            ]
              .filter(Boolean)
              .join(" ")}
            aria-label={`${item.badge} ${item.id === "alertas" ? "alertas" : "notificações"}`}
          >
            {item.badge}
          </span>
        )}
      </Link>
    </li>
  );
}
</file>

<file path="components/panels/PostingProfilePanel.module.css">
/* ==========================================================================
   ORBIT · Component — PostingProfilePanel.module.css (RWP-3)
   Versão: 1.2.0  |  Data: 2026-10-06

   v1.2.0: o TSX passou a usar 5 classes que não existiam aqui (reference,
   referenceHead, referenceLine, referenceMeta, referenceMuted — bloco de
   referência do segmento). Sem elas, CSS Modules devolve `undefined` e o
   bloco renderizava sem estilo nenhum. Adicionadas abaixo, mesmo glasscard
   do QualityScoresPanel (gradiente cyan sutil + borda cyan translúcida +
   glow inset), aninhado dentro de .block com raio menor (--r6) e SEM
   hover/lift próprio, para não competir com o .block pai.

   Mesmo vocabulário do QualityScoresPanel.module.css:
   painel = .panel; bloco interno = .scoreBox + .boxCyan; sem estado de
   alerta (cadência e mix são contagem, nunca semáforo). 100% tokens SSOT.
   A cor da posição (gold/cyan) vem do StatusPill — o container da
   referência fica sempre cyan, neutro.
   ========================================================================== */

/* ═══════════════════════════════════════════════════════════════
   PAINEL PRINCIPAL
   ═══════════════════════════════════════════════════════════════ */

.panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-4);
  background-color: var(--bg2);
  border: 1px solid var(--line);
  border-radius: var(--r12);
  box-shadow: var(--shadow-glow-cyan);
  transition: all var(--transition-base);
}

.panel:hover {
  border-color: var(--border-glow-cyan);
  box-shadow: var(--shadow-glow-cyan-30);
}

/* ═══════════════════════════════════════════════════════════════
   TÍTULO + BADGE DE NÍVEL
   ═══════════════════════════════════════════════════════════════ */

.titleRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--line);
}

.title {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--neon-cyan);
  text-transform: uppercase;
  margin: 0;
}

.levelBadge {
  display: inline-block;
  padding: var(--space-1) var(--space-2);
  border-radius: var(--r4);
  font-family: var(--mono);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--t1);
  background-color: var(--bg3);
  border: 1px solid var(--line2);
}

/* ═══════════════════════════════════════════════════════════════
   GRID DOS 2 BLOCOS (Cadência | Mix)
   ═══════════════════════════════════════════════════════════════ */

.blocks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

@media (max-width: 768px) {
  .blocks {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* ═══════════════════════════════════════════════════════════════
   BLOCO — mesma receita de .scoreBox + .boxCyan
   ═══════════════════════════════════════════════════════════════ */

.block {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: var(--gradient-cyan-subtle);
  border: 1px solid rgba(var(--color-cyan-rgb), var(--opacity-30));
  border-radius: var(--r8);
  box-shadow: var(--shadow-glow-cyan-inset);
  transition:
    transform var(--transition-fast),
    box-shadow var(--transition-fast),
    border-color var(--transition-fast),
    background var(--transition-fast);
  cursor: default;
}

.block:hover {
  background: var(--gradient-cyan-hover);
  border-color: rgba(var(--color-cyan-rgb), var(--opacity-50));
  box-shadow: var(--shadow-glow-cyan-inset-hover);
  transform: translateY(-2px);
}

/* ═══════════════════════════════════════════════════════════════
   CONTEÚDO DO BLOCO
   ═══════════════════════════════════════════════════════════════ */

.label {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: 0.03em;
  color: var(--text-muted);
  text-transform: uppercase;
  margin: 0;
}

.headline {
  font-family: var(--mono);
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
  color: var(--neon-cyan);
  /* "1 post a cada 12,3 semanas" é longo p/ meia coluna em 22px mono */
  overflow-wrap: anywhere;
}

/* sem base: neutro, nunca vermelho/âmbar (ausência de dado não é alerta) */
.headlineMuted {
  composes: headline;
  font-size: var(--font-size-2xl);
  color: var(--t1);
}

.detail {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  line-height: var(--line-height-base);
  color: var(--text-muted);
  margin: 0;
}

/* ═══════════════════════════════════════════════════════════════
   REFERÊNCIA DO SEGMENTO (dentro do bloco Cadência)
   Glasscard aninhado: mesmo gradiente/borda/glow cyan do .block, um
   degrau mais quieto (raio menor, borda mais fraca, sem hover/lift).
   A cor de posição (gold/cyan) NÃO vem daqui — vem do StatusPill.
   ═══════════════════════════════════════════════════════════════ */

.reference {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-top: var(--space-2);
  padding: var(--space-3);
  background: var(--gradient-cyan-subtle);
  border: 1px solid rgba(var(--color-cyan-rgb), 0.2);
  border-radius: var(--r6);
  box-shadow: var(--shadow-glow-cyan-inset);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

.referenceHead {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding-bottom: var(--space-2);
  margin-bottom: var(--space-1);
  border-bottom: 1px solid var(--line);
}

/* linha principal: média · mediana (o dado que o leitor compara) */
.referenceLine {
  font-family: var(--font);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-base);
  color: var(--text-primary);
  margin: 0;
  overflow-wrap: anywhere;
}

/* faixa P25–P75, contas, período fixo (contexto, não destaque) */
.referenceMeta {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  line-height: var(--line-height-relaxed);
  color: var(--text-muted);
  margin: 0;
  overflow-wrap: anywhere;
}

/* sem referência: neutro, sem borda/glow — ausência não é alerta */
.referenceMuted {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-style: italic;
  line-height: var(--line-height-base);
  color: var(--text-muted);
  margin: var(--space-2) 0 0;
}

/* ═══════════════════════════════════════════════════════════════
   MIX DE FORMATOS
   ═══════════════════════════════════════════════════════════════ */

.mixList {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.mixRow {
  display: grid;
  grid-template-columns: 1fr auto;
  column-gap: var(--space-3);
  row-gap: var(--space-1);
  align-items: baseline;
  font-family: var(--font);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
}

.mixCount {
  font-family: var(--mono);
  font-size: var(--font-size-xs);
  color: var(--t1);
}

/* largura da barra vem de --pct, definida inline no TSX */
.barTrack {
  grid-column: 1 / -1;
  height: 4px;
  border-radius: var(--radius-pill);
  background: var(--line);
  overflow: hidden;
}

.barFill {
  display: block;
  height: 100%;
  width: var(--pct, 0%);
  background: var(--neon-cyan);
  border-radius: inherit;
}

/* ═══════════════════════════════════════════════════════════════
   NOTA DE RODAPÉ
   ═══════════════════════════════════════════════════════════════ */

.note {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-style: italic;
  line-height: var(--line-height-relaxed);
  color: var(--text-muted);
  margin: 0;
  padding: var(--space-3) var(--space-4);
  border-left: 3px solid var(--neon-cyan);
  background-color: rgba(var(--color-cyan-rgb), 0.05);
  border-radius: var(--r8);
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVIDADE E ACESSIBILIDADE
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .panel,
  .block {
    transition: none;
  }

  .block:hover {
    transform: none;
  }
}

.panel:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 2px;
}
</file>

<file path="components/panels/PostingProfilePanel.tsx">
/* ==========================================================================
   ORBIT · PostingProfilePanel (RWP-3)
   Cadência e mix de formatos (contagem direta dos posts) + referência de
   cadência do segmento (view v_benchmark_cadence_by_segment).

   Regras:
   - Número principal (oráculo): Cadência baseada na JANELA EFETIVA (período selecionado).
   - Conta e referência usam a MESMA régua para cor/comparação: posts por semana 
     entre o primeiro e o último post (span ativo), só com base mínima (>= 5 posts e >= 28 dias).
   - A referência é de PERÍODO FIXO (o da própria view), não o período
     selecionado. As datas aparecem escritas na tela.
   - Contas sem posts qualificáveis NÃO entram como zero; "n de N contas"
     (elegíveis) aparece junto da média, com o número de contas recentes.
   - Recência = dias entre o último post e a DATA DA COLETA da conta, nunca até
     hoje: o dado só fala até a coleta. Exibida separada da cadência.
   - Cor = posição na faixa P25–P75 que a view entrega. Descritiva, nunca
     vermelha, nunca CTA, nunca promessa de efeito em conversão.
   - Sem amostra mínima ou sem cadência de span ativo da conta: sem cor, só
     os números.
   ========================================================================== */

import type { CSSProperties } from "react";
import { StatusPill } from "@/components/common/StatusPill";
import { formatCategoryLabel } from "@/lib/repositories/contentContractEngine";
import type {
  PostingCadence,
  FormatMix,
  BenchmarkCadence,
  GlowColor,
} from "@/types/orbit";
import styles from "./PostingProfilePanel.module.css";
import { provenanceLine } from "@/lib/provenanceText";
import type { MetricProvenance } from "@/types/orbit";

// RN-23 / D-21: cadência = posts do cabeçalho; referência = view com período
// fixo. A view não expõe benchmark_run_id (proveniência de run pendente).
const CADENCE_PROVENANCE: MetricProvenance = {
  source:
    "cálculo por post (ig_posts) · referência orbit.v_benchmark_cadence_by_segment",
  period: "header_window",
  periodLabel:
    "posts do cabeçalho; referência em período fixo informado acima",
  method:
    "posts ÷ semanas do período; ritmo ativo = do primeiro ao último post; compara com P25–P75 do segmento (mínimo 5 posts); run da referência ainda não exposto pela view (D-21)",
};

const FORMAT_LABEL: Record<string, string> = {
  reel: "Reels",
  static_post: "Estático",
  carousel: "Carrossel",
  story: "Stories",
  live: "Live",
  igtv: "IGTV",
  sem_formato: "Sem formato",
};

// Decisão de produto: abaixo disso a referência aparece sem cor.
// Conta contas ELEGÍVEIS (>= 5 posts e >= 28 dias de span), não contas observadas.
const MIN_BENCHMARK_ACCOUNTS = 5;

type CadencePosition = "abaixo" | "faixa" | "acima";

const POSITION_UI: Record<CadencePosition, { text: string; color: GlowColor }> =
  {
    abaixo: { text: "Abaixo da faixa típica do segmento", color: "gold" },
    faixa: { text: "Na faixa típica do segmento", color: "cyan" },
    acima: { text: "Acima da faixa típica do segmento", color: "gold" },
  };

function ptBr(value: number, decimals = 1): string {
  return value.toFixed(decimals).replace(".", ",");
}

// 'YYYY-MM-DD' (ou timestamp) -> 'DD/MM/YYYY' sem passar por Date,
// que deslocaria o dia por fuso horário.
function fmtIsoDate(iso: string): string {
  return iso.slice(0, 10).split("-").reverse().join("/");
}

function plural(n: number, singular: string, pluralForm: string): string {
  return n === 1 ? singular : pluralForm;
}

// Taxa para o BENCHMARK: span ativo, quando a conta tem base mínima.
function activeRate(c: PostingCadence | null | undefined): number | null {
  return c?.postsPerWeekActive ?? null;
}

// Headline da cadência baseada na JANELA EFETIVA (oráculo), e não no span ativo.
function cadenceHeadline(c: PostingCadence): string {
  if (c.reason !== "ok" || c.postsPerWeek === null) {
    return "Poucos posts para calcular";
  }

  if (c.postsPerWeek < 1 && c.weeksPerPost !== null) {
    return `1 post a cada ${ptBr(c.weeksPerPost)} semanas`;
  }
  return `${ptBr(c.postsPerWeek)} posts por semana`;
}

// Detalhamento mesclando os dados da janela com o span ativo
function cadenceDetail(c: PostingCadence): string {
  const dias = Math.round(c.windowDays);

  if (c.reason !== "ok") {
    return `${c.nPosts} ${plural(c.nPosts, "post", "posts")} no período — mínimo de 3 para estimar o ritmo.`;
  }

  const windowText = `${c.nPosts} ${plural(c.nPosts, "post", "posts")} em ${dias} dias (período selecionado).`;

  const active = activeRate(c);
  if (active !== null && c.activeSpanDays != null) {
    return `${windowText} Ritmo ativo de ${ptBr(active)} posts/sem (em ${c.activeSpanDays} dias, do primeiro ao último post).`;
  }

  return `${windowText} Sem base mínima de 5 posts em 28 dias para extrair ritmo ativo ou comparar com o segmento.`;
}

// Recência separada da cadência: "com que ritmo postou quando postava" (acima)
// vs "há quanto tempo parou" (aqui), medida até a coleta, não até hoje.
function recencyLine(c: PostingCadence): string | null {
  if (
    c.lastPostOn == null ||
    c.collectedOn == null ||
    c.daysLastPostToCollection == null
  )
    return null;
  const d = c.daysLastPostToCollection;
  return `Último post em ${fmtIsoDate(c.lastPostOn)} — ${d} ${plural(d, "dia", "dias")} antes da coleta (${fmtIsoDate(c.collectedOn)}).`;
}

// Compara posts/semana (span ativo) da conta com a faixa P25–P75 da view.
function classifyCadenceVsBenchmark(
  postsPerWeek: number,
  b: BenchmarkCadence,
): CadencePosition {
  if (postsPerWeek < b.p25PostsPerWeek) return "abaixo";
  if (postsPerWeek > b.p75PostsPerWeek) return "acima";
  return "faixa";
}

export interface PostingProfilePanelProps {
  cadence: PostingCadence | null | undefined;
  mix: FormatMix | null | undefined;
  benchmark?: BenchmarkCadence | null | undefined;
}

export function PostingProfilePanel({
  cadence,
  mix,
  benchmark,
}: PostingProfilePanelProps) {
  // Account rate usado EXCLUSIVAMENTE para a cor do benchmark (apples-to-apples)
  const accountRate = activeRate(cadence);

  const canColor =
    !!benchmark &&
    benchmark.eligibleAccounts >= MIN_BENCHMARK_ACCOUNTS &&
    accountRate !== null;

  const position =
    canColor && benchmark && accountRate !== null
      ? POSITION_UI[classifyCadenceVsBenchmark(accountRate, benchmark)]
      : null;

  const cadenceOk = !!cadence && cadence.reason === "ok";
  const recency = cadence ? recencyLine(cadence) : null;

  return (
    <section
      className={styles.panel}
      aria-label="Ritmo e mix de publicação"
      data-testid="posting-profile"
    >
      <div className={styles.titleRow}>
        <h3 className={styles.title}>Ritmo e mix de publicação</h3>
        <span
          className={styles.levelBadge}
          data-testid="posting-level"
          title="Derivado por contagem dos posts coletados."
        >
          L1
        </span>
      </div>

      <div className={styles.blocks}>
        <div
          className={styles.block}
          data-testid="posting-cadence"
          data-value={cadence?.postsPerWeek ?? ""}
          data-value-active={accountRate ?? ""}
          data-n={cadence?.nPosts ?? 0}
          data-benchmark-median={benchmark?.medianPostsPerDay ?? ""}
          data-benchmark-median-week={benchmark?.medianPostsPerWeek ?? ""}
        >
          <span className={styles.label}>Cadência</span>
          {cadence ? (
            <>
              <strong
                className={cadenceOk ? styles.headline : styles.headlineMuted}
              >
                {cadenceHeadline(cadence)}
              </strong>
              <p className={styles.detail}>{cadenceDetail(cadence)}</p>
              {recency && (
                <p className={styles.detail} data-testid="posting-recency">
                  {recency}
                </p>
              )}
            </>
          ) : (
            <strong className={styles.headlineMuted}>
              Sem dados no período
            </strong>
          )}

          {benchmark ? (
            <div className={styles.reference} data-testid="posting-benchmark">
              {position && (
                <div className={styles.referenceHead}>
                  <StatusPill text={position.text} color={position.color} />
                </div>
              )}
              <p className={styles.referenceLine}>
                Referência — {formatCategoryLabel(benchmark.segmentCategory)}:
                média {ptBr(benchmark.meanPostsPerWeek, 2)} posts/semana ·
                mediana {ptBr(benchmark.medianPostsPerWeek, 2)}
              </p>
              <p className={styles.referenceMeta}>
                Faixa típica (P25–P75): {ptBr(benchmark.p25PostsPerWeek, 2)} a{" "}
                {ptBr(benchmark.p75PostsPerWeek, 2)} posts/semana ·{" "}
                {benchmark.eligibleAccounts} de{" "}
                {benchmark.benchmarkAccountsTotal} contas elegíveis ·{" "}
                {fmtIsoDate(benchmark.periodStart)} a{" "}
                {fmtIsoDate(benchmark.periodEnd)}
              </p>
              <p
                className={styles.referenceMeta}
                data-testid="posting-benchmark-recency"
              >
                {benchmark.recentAccounts} de {benchmark.eligibleAccounts} com
                último post até {benchmark.recencyThresholdDays} dias antes da
                coleta
                {benchmark.medianDaysLastPostToCollection !== null
                  ? ` · mediana de ${Math.round(benchmark.medianDaysLastPostToCollection)} dias`
                  : ""}
              </p>
              {benchmark.eligibleAccounts < MIN_BENCHMARK_ACCOUNTS && (
                <p className={styles.referenceMeta}>
                  Poucas contas na referência — exibida sem comparação.
                </p>
              )}
              {accountRate === null &&
                benchmark.eligibleAccounts >= MIN_BENCHMARK_ACCOUNTS && (
                  <p className={styles.referenceMeta}>
                    Conta sem base mínima (5 posts em 28 dias) — referência
                    exibida sem comparação.
                  </p>
                )}
            </div>
          ) : (
            <p
              className={styles.referenceMuted}
              data-testid="posting-benchmark-empty"
            >
              Sem referência de segmento disponível para esta conta.
            </p>
          )}
        </div>

        <div
          className={styles.block}
          data-testid="posting-mix"
          data-total={mix?.total ?? 0}
        >
          <span className={styles.label}>Mix de formatos</span>
          {mix && mix.items.length > 0 ? (
            <ul className={styles.mixList}>
              {mix.items.map((item) => (
                <li
                  key={item.format}
                  className={styles.mixRow}
                  data-format={item.format}
                  data-count={item.count}
                >
                  <span>{FORMAT_LABEL[item.format] ?? item.format}</span>
                  <span className={styles.mixCount}>
                    {item.count} {item.count === 1 ? "post" : "posts"} ·{" "}
                    {ptBr(item.pct)}%
                  </span>
                  <span className={styles.barTrack} role="presentation">
                    <span
                      className={styles.barFill}
                      style={
                        {
                          "--pct": `${Math.max(2, Math.min(100, item.pct))}%`,
                        } as CSSProperties
                      }
                    />
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <strong className={styles.headlineMuted}>
              Sem posts no período
            </strong>
          )}
        </div>
      </div>

      <p className={styles.note}>{provenanceLine(CADENCE_PROVENANCE)}</p>

      <p className={styles.note}>
        {benchmark
          ? "A cadência principal reflete o período selecionado. A comparação de segmento exige base mínima e avalia o ritmo ativo (do primeiro ao último post). A referência usa um período fixo e descreve o ritmo observado — não indica efeito sobre resultado. A recência é medida até a coleta."
          : "Contagem dos posts coletados no período selecionado, sem comparação de mercado."}
      </p>
    </section>
  );
}
</file>

