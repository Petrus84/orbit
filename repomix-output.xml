// de chamar formatPtBr(null) diretamente. Não fabrica um 0 — declara a
// ausência.
function formatVpsSegment(vpsPct: number | null): string {
  if (vpsPct == null) {
    return AUSENCIA.vps;
  }
  return `${formatPtBr(vpsPct)}% dos seguidores viram`;
