<file path="src/components/layout/navItemMapping.ts">
/* ==========================================================================
   ORBIT · Navigation Mapping (v2.1.0 — ALINHADO ÀS 11 RNs DO SSOT)
   Caminho: src/components/layout/navItemMapping.ts
   Versão: 2.1.0 | Data: 2026-07-05

   GOVERNANÇA RÍGIDA APLICADA:
   ✅ R-01: Visão unificada de carteira — semáforo de saúde → /carteira
   ✅ R-02: Alerta proativo com threshold configurável → /alertas
   ✅ R-03: Flag de confiança L0/L1/L2 em todo número → (estrutura de dados)
   ✅ R-04: Funil interativo com simulador de cenário → /instagram/funil
   ✅ R-05: Score de polêmica e utilidade separados → (estrutura de dados)
   ✅ R-06: Sparklines de tendência inline (8 semanas) → (estrutura de dados)
   ✅ R-07: Visão unificada orgânico + pago → /instagram (overview)
   ✅ R-08: Score de fadiga de criativo → (estrutura de dados)
   ✅ R-09: Link de ação direto em cada insight → (estrutura de dados)
   ✅ R-10: Mobile-first e modo apresentação → (estrutura de dados)
   ✅ R-11: Auditoria de consistência de avatar → /instagram/avatar

   MUDANÇAS v2.1.0:
   • Removidas todas as referências a "Estudo de Mercado"
   • Estrutura de validação reforçada com whitelist explícita
   • Comentários alinhados às 11 RNs
   • Função isValidNavItem() agora usa whitelist completa
   ========================================================================== */

import type { TabId } from '@/types/orbit'

/**
 * WHITELIST OFICIAL DE ITENS DE NAVEGAÇÃO
 * Apenas itens que SÃO abas dentro de /instagram ficam aqui.
 * Funil e Avatar foram promovidos para rotas próprias (R-04, R-11).
 */
export const NAV_ITEM_TO_TAB_MAP: Record<string, TabId> = {
  'visao-geral-ig': 'overview', // R-07: Visão unificada orgânico + pago
} as const

/**
 * WHITELIST OFICIAL DE ROTAS DE NAVEGAÇÃO
 * Todas as rotas válidas no sistema, alinhadas às 11 RNs do SSOT.
 */
const VALID_NAV_ITEMS = new Set<string>([
  'carteira',              // R-01: Visão unificada de carteira — semáforo de saúde
  'alertas',               // R-02: Alerta proativo com threshold configurável
  'visao-geral-ig',        // R-07: Visão unificada orgânico + pago
  'funil-simulador',       // R-04: Funil interativo com simulador de cenário
  'avatar-alignment',      // R-11: Auditoria de consistência de avatar
  'onboarding',            // Sem RN — item de menu, ver ADR-010/Sidebar.tsx
])

/**
 * Retorna a aba esperada para um item de navegação, se aplicável.
 * Apenas itens em NAV_ITEM_TO_TAB_MAP retornam uma aba.
 * Rotas independentes (funil, avatar, carteira, alertas) retornam null.
 *
 * @param itemId - Identificador único do item de navegação
 * @returns TabId | null — 'overview' para visao-geral-ig, null para rotas
 */
export function getTabForNavItem(itemId: string): TabId | null {
  return NAV_ITEM_TO_TAB_MAP[itemId] ?? null
}

/**
 * Determina se um item de nav está ativo.
 *
 * Lógica v2.1.0 (alinhada às 11 RNs):
 * - Se o item mapeia para uma aba (visao-geral-ig):
 *   ativo se pathname === href E activeTab === expectedTab
 * - Se NÃO mapeia para aba (funil-simulador, avatar-alignment, carteira, alertas):
 *   ativo apenas se pathname === href (ou começa com href para rotas aninhadas)
 *
 * @param itemId - Identificador único do item de navegação
 * @param pathname - Caminho atual da URL (ex: '/instagram', '/carteira')
 * @param itemHref - Href configurado no item (ex: '/instagram', '/carteira')
 * @param activeTab - Aba ativa dentro de /instagram (ex: 'overview')
 * @returns boolean — true se o item deve ser renderizado como ativo
 */
export function isNavItemActive(
  itemId: string,
  pathname: string,
  itemHref: string,
  activeTab: TabId
): boolean {
  const expectedTab = getTabForNavItem(itemId)

  if (expectedTab) {
    // É uma aba — precisa estar na rota E na aba certa
    return pathname === itemHref && activeTab === expectedTab
  }

  // É uma rota independente — apenas pathname
  // Usa startsWith para cobrir sub-rotas (ex: /instagram/funil/detail)
  return pathname === itemHref || pathname.startsWith(itemHref + '/')
}

/**
 * Retorna uma cópia do mapa de abas para consumo externo.
 * Garante imutabilidade do mapa original.
 *
 * @returns Record<string, TabId> — Cópia de NAV_ITEM_TO_TAB_MAP
 */
export function getNavItemMapping(): Record<string, TabId> {
  return { ...NAV_ITEM_TO_TAB_MAP }
}

/**
 * Valida se um item de navegação é reconhecido pelo sistema.
 * Usa whitelist explícita alinhada às 11 RNs do SSOT.
 *
 * WHITELIST VÁLIDA:
 * - carteira (R-01)
 * - alertas (R-02)
 * - visao-geral-ig (R-07)
 * - funil-simulador (R-04)
 * - avatar-alignment (R-11)
 *
 * @param itemId - Identificador único do item de navegação
 * @returns boolean — true se o item está na whitelist oficial
 */
export function isValidNavItem(itemId: string): boolean {
  return VALID_NAV_ITEMS.has(itemId)
}
</file>

<file path="src/actions/syncClientAlerts.ts">
"use server";

// ============================================================================
// src/actions/syncClientAlerts.ts  (v4.0.0 — substitui a v3.0.2)
//
// Mudanças:
// 1) AUTORIZAÇÃO: antes qualquer chamador passava um clientId arbitrário.
//    Agora exige sessão e só prossegue se o cliente é visível ao usuário via
//    RLS (policy authenticated_select_own_clients) — só então a escrita usa
//    service_role. Sem isso, trocar INSERT por service_role seria um IDOR.
// 2) LEITURA: os repositórios usavam o client anon do navegador, que no
//    servidor não tem sessão (RLS devolve vazio => "cliente não encontrado" /
//    snapshot null). O client com cookies do servidor é injetado.
// 3) ESCRITA: upsertAlertsBatch (find-or-update, idempotente) no lugar de
//    createAlertsBatch (INSERT puro, quebra em alerts_dedup).
// 4) fetchInstagramOverview removido: servia só para montar a mensagem.
// ============================================================================

import { createSupabaseServerClient } from "@/lib/supabase/server";
import {
  fetchLatestEngagementScoreSnapshot,
  fetchClientOnboarding,
} from "@/lib/repositories/instagramOverviewRepository";
import type { OrbitDbClient } from "@/lib/repositories/instagramOverviewRepository";
import {
  resolveEngagementScoreAlert,
  mapSegmentToCategory,
  mapFollowersToTier,
} from "@/lib/repositories/contentContractEngine";
import type { AlertDraft } from "@/lib/repositories/contentContractEngine";
import {
  upsertAlertsBatch,
  resolveOpenAlertForKey,
} from "@/lib/repositories/alertsWriter.server";

// DECISÃO DE PRODUTO (pendente no chat): quais severidades viram linha em
// orbit.alerts. Default = só warning/critical, igual ao que a tela já faz em
// fetchCriticalAlerts (instagramOverviewRepository). Para manter a aba "Info"
// na Central, mude para true — o writer então atualiza a linha no lugar.
const PERSIST_INFO_ALERTS = false;
const AUTO_RESOLVED_BY = "system:syncClientAlerts";

export interface SyncClientAlertsResult {
  success: boolean;
  alertsGenerated: number; // inseridos
  alertsUpdated: number; // atualizados in-place ou reabertos
  alertsSkipped: number; // transitórios ou já resolvidos para o mesmo snapshot
  alertsAutoResolved: number; // abertos cuja condição acabou (draft info na mesma chave)
  clientHandle?: string | undefined;
  message?: string | undefined;
  error?: string | undefined;
}

const fail = (error: string): SyncClientAlertsResult => ({
  success: false,
  alertsGenerated: 0,
  alertsUpdated: 0,
  alertsSkipped: 0,
  alertsAutoResolved: 0,
  error,
});

export async function syncClientAlerts(
  clientId: string,
): Promise<SyncClientAlertsResult> {
  try {
    const db = await createSupabaseServerClient();

    const { data: auth } = await db.auth.getUser();
    if (!auth.user) return fail("Não autenticado.");

    // RLS decide: se o usuário não é dono do cliente, volta null.
    const { data: client, error: clientErr } = await db
      .schema("orbit")
      .from("clients")
      .select("id, name, handle")
      .eq("id", clientId)
      .maybeSingle();
    if (clientErr)
      throw new Error(
        `[Orquestrador] leitura do cliente falhou: ${clientErr.message}`,
      );
    if (!client) return fail("Cliente não encontrado ou sem permissão.");

    const end = new Date();
    const start = new Date(end);
    start.setDate(start.getDate() - 90);

    // Cast único e deliberado: o client do @supabase/ssr não é tipado com
    // Database<'orbit'>; os leitores só usam .schema('orbit').from(...).
    const readerDb = db as unknown as OrbitDbClient;

    const drafts: AlertDraft[] = [];
    let autoResolved = 0;
    const [snapshot, onboarding] = await Promise.all([
      fetchLatestEngagementScoreSnapshot(
        clientId,
        start.toISOString(),
        end.toISOString(),
        readerDb,
      ),
      fetchClientOnboarding(clientId, readerDb),
    ]);
    if (snapshot) {
      // Mesma categoria/porte que a tela usa (fetchCriticalAlerts): sem isso o
      // sync classificaria em 'all'/'all' e o alerta persistido divergiria do
      // que o usuário vê no overview.
      const category = mapSegmentToCategory(
        onboarding?.setor_benchmark ?? null,
      );
      const tier = mapFollowersToTier(onboarding?.total_followers ?? null);
      const draft = await resolveEngagementScoreAlert(
        snapshot,
        category,
        tier,
        readerDb,
      );

      const persistable =
        PERSIST_INFO_ALERTS ||
        (draft.severity !== "info" && draft.severity !== "success");
      if (persistable) {
        drafts.push(draft);
      } else {
        // Condição cleared para esta chave: fecha o alerta aberto, se houver.
        autoResolved += await resolveOpenAlertForKey(
          client.id,
          { type: draft.type, metricName: draft.metricName ?? null },
          AUTO_RESOLVED_BY,
        );
      }
    }

    const results = drafts.length
      ? await upsertAlertsBatch(client.id, drafts)
      : [];
    const count = (a: string) => results.filter((r) => r.action === a).length;

    return {
      success: true,
      alertsGenerated: count("inserted"),
      alertsUpdated: count("updated") + count("reopened"),
      alertsSkipped:
        results.length -
        count("inserted") -
        count("updated") -
        count("reopened"),
      alertsAutoResolved: autoResolved,
      clientHandle: client.handle,
      message:
        results.length === 0 && autoResolved === 0
          ? "Nenhum alerta neste ciclo: só o CASO G (engagement score) tem fonte de dado hoje e não há snapshot completo ou alerta aplicável."
          : undefined,
    };
  } catch (error) {
    console.error(
      `[Orquestrador] Falha ao sincronizar alertas para ${clientId}:`,
      error,
    );
    return fail(error instanceof Error ? error.message : "Erro desconhecido");
  }
}
</file>

