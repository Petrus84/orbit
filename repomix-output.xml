[
  {"kpi_nome":"Saldo de Seguidores do Período","regra_calculo":"saldo_seguidores = follower_count(T1) - follower_count(T0)"},
  {"kpi_nome":"Semáforo de Seguidores","regra_calculo":"SE saldo_seguidores(semana_n) < 0 E saldo_seguidores(semana_n-1) < 0 ENTÃO vermelho; SENÃO verde"},
  {"kpi_nome":"Engajamento do Período","regra_calculo":"engajamento_delta = ((engajamento_T1 - engajamento_T0) / engajamento_T0) * 100"},
  {"kpi_nome":"Semáforo de Engajamento","regra_calculo":"SE engajamento_delta < -30% ENTÃO vermelho; SE entre -30% e 0% ENTÃO âmbar; SENÃO verde"},
  {"kpi_nome":"Custo por Resultado vs Meta","regra_calculo":"cpr_vs_meta = (custo_resultado_real / meta_custo_resultado) * 100"},
  {"kpi_nome":"Semáforo de Custo por Resultado","regra_calculo":"SE cpr_vs_meta > 120% ENTÃO vermelho; SE entre 100% e 120% ENTÃO âmbar; SENÃO verde"},
  {"kpi_nome":"CTR (Click-Through Rate)","regra_calculo":"CTR = (cliques / impressoes) * 100; threshold padrão: alerta se abaixo de 1% no Meta ou 2% no Google Search"},
  {"kpi_nome":"Alerta de CTR Abaixo do Threshold","regra_calculo":"SE CTR_meta < threshold_ctr_meta (padrão 1%) OU CTR_google < threshold_ctr_google (padrão 2%) ENTÃO alerta = true"},
  {"kpi_nome":"CPA — Custo por Aquisição","regra_calculo":"CPA = spend / conversions; alerta SE CPA > 1.5 * media_CPA_14d"},
  {"kpi_nome":"Frequência de Anúncio","regra_calculo":"frequency = impressions / reach; alerta SE frequency > 3"},
  {"kpi_nome":"Flag de Confiança L0 (Dado Oficial)","regra_calculo":"SE origem == 'api_oficial' E sem_transformacao == true ENTÃO nivel = 'L0'"},
  {"kpi_nome":"Flag de Confiança L1 (Calculado com Fórmula Conhecida)","regra_calculo":"SE origem == 'calculo_sobre_api' E margem_erro < 40% ENTÃO nivel = 'L1'"},
  {"kpi_nome":"Flag de Confiança L2 (Estimativa por Benchmark)","regra_calculo":"SE origem == 'benchmark_mercado' ENTÃO nivel = 'L2'; excluir de calculos_automaticos"},
  {"kpi_nome":"Vendas Estimadas pelo Funil Orgânico","regra_calculo":"vendas_estimadas = alcance × CTR_perfil × CTR_link × taxa_conversao"},
  {"kpi_nome":"Score de Polêmica","regra_calculo":"score_polemica = (comentarios / curtidas) * 100; ALERTA SE > 20%"},
  {"kpi_nome":"Score de Utilidade","regra_calculo":"score_utilidade = ((salvamentos + compartilhamentos) / alcance) * 100; ÂMBAR SE < 1%; SAUDÁVEL SE >= 2%"},
  {"kpi_nome":"Sparkline de Tendência — Slope de 8 Semanas","regra_calculo":"slope = regressao_linear(valores_8_semanas); alerta SE slope < 0 por 14 dias consecutivos"},
  {"kpi_nome":"Candidato a Boost — Badge de Impulsionamento","regra_calculo":"c1 = compartilhamentos > 0.02*base; c2 = saves/alcance > 0.03; c3 = alcance_nao_seguidores/alcance > 0.40; 1=candidato; 2+=forte"},
  {"kpi_nome":"Score de Fadiga de Criativo","regra_calculo":"fadiga = ((CTR_semana1 - CTR_semana_atual) / CTR_semana1) * 100"},
  {"kpi_nome":"Diagnóstico de Causa da Fadiga","regra_calculo":"SE fadiga > 40% E frequency > 2.5 ENTÃO 'saturacao_criativo'; SE fadiga > 40% E frequency < 2.5 ENTÃO 'problema_segmentacao'; SENÃO 'saudavel'"},
  {"kpi_nome":"Score de Alinhamento de Avatar — Gênero","regra_calculo":"alinhamento_genero = 100 - abs(percentual_esperado - percentual_real); CRITICO SE < 70%; ÂMBAR SE 70-85%; VERDE SE > 85%"},
  {"kpi_nome":"Score de Alinhamento de Avatar — Faixa Etária","regra_calculo":"alinhamento_idade = 100 - abs(percentual_faixa_esperada - percentual_faixa_real); CRITICO SE < 70%; ÂMBAR SE 70-85%; VERDE SE > 85%"},
  {"kpi_nome":"Score de Alinhamento de Avatar — Cidade","regra_calculo":"alinhamento_cidade = percentual_audiencia_na_cidade_alvo; CRITICO SE < 70%; ÂMBAR SE 70-85%; VERDE SE > 85%"},
  {"kpi_nome":"Alcance Orgânico — Seguidores vs Não-Seguidores","regra_calculo":"alcance_seguidores = reach[follower]; alcance_nao_seguidores = reach[non_follower]"},
  {"kpi_nome":"Engajamento Qualificado — Save Rate","regra_calculo":"save_rate = (salvamentos / alcance) * 100; usado no boost com threshold > 3%"},
  {"kpi_nome":"Performance por Formato de Conteúdo","regra_calculo":"agrupar_por(media_type); calcular media(reach), media(likes+comments+saves), media(save_rate) por grupo"},
  {"kpi_nome":"Pico de Atividade da Audiência","regra_calculo":"extrair distribuição de audience_online_followers por hora e dia; top 3 janelas de pico"},
  {"kpi_nome":"Gasto Real vs Planejado (Burn Rate)","regra_calculo":"burn_rate_diario = spend_acumulado / dias_decorridos; pace_esperado = budget_total / dias_totais"},
  {"kpi_nome":"Impression Share — Intenção de Busca (Google)","regra_calculo":"impression_share = impressoes_recebidas / impressoes_elegiveis_estimadas * 100"},
  {"kpi_nome":"Taxa de Conversão de Landing Page","regra_calculo":"taxa_conversao_lp = (conversoes / sessoes) * 100; segmentar por canal de origem"}
]
