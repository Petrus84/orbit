.globalAlertsHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.globalAlertsLabel {
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--t1);
}

.globalAlertsBadge {
  border-radius: 9999px;
  border: 1px solid var(--line);
  background-color: var(--bg2);
  padding-left: 0.5rem;
  padding-right: 0.5rem;
  padding-top: 0.25rem;
  padding-bottom: 0.25rem;
  font-family: var(--mono);
  font-size: 0.625rem;
  font-weight: 600;
  color: var(--red);
}

.globalAlertsList {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
