}

@media (min-width: 1024px) {
  .midRow {
    grid-template-columns: 1fr 1fr;
  }
}

.rightPanel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.insightStack {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

/* Diagnóstico — sub-título de seção sem card ao redor, igual ao protótipo (linha ~832) */
.diagnosticHead {
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--text-primary);
}

.alertRow {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.stateCenter {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-12) 0;
}

.loadingDot {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin: 0 3px;
  border-radius: 50%;
  background: var(--acc);
  animation: bounce 1s infinite ease-in-out;
