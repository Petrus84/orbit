  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 1rem;
  border: 1px solid var(--line);
  background-color: rgba(24, 24, 31, 0.2);
  padding-top: 3rem;
  padding-bottom: 3rem;
}

.emptyMessage {
  font-size: 0.875rem;
  color: var(--text-muted);
}

/* ─── Clients Grid ───────────────────────────────────────────────────── */

.clientsGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

/* ✅ FIX principal: @media → @container. Antes, este grid contava colunas
   com base na largura da JANELA (ignorando os 220px da sidebar); agora
   conta com base na largura real disponível para o .main (container
   "carteira" definido acima) — os cards voltam a ter o tamanho/proporção
   desenhados independente da largura da sidebar. */
@container carteira (min-width: 640px) {
  .clientsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@container carteira (min-width: 1024px) {
  .clientsGrid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@container carteira (min-width: 1280px) {
  .clientsGrid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.clientWrapper {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.alertsContainer {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-left: 0.25rem;
}

/* ─── Global Alerts Section ──────────────────────────────────────────── */

.globalAlertsSection {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border-top: 1px solid var(--line);
  padding-top: 1.25rem;
}

.globalAlertsHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.globalAlertsLabel {
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--t1);
}

.globalAlertsBadge {
  border-radius: 9999px;
  border: 1px solid var(--line);
  background-color: var(--bg2);
  padding-left: 0.5rem;
  padding-right: 0.5rem;
  padding-top: 0.25rem;
  padding-bottom: 0.25rem;
  font-family: var(--mono);
  font-size: 0.625rem;
  font-weight: 600;
  color: var(--red);
}

.globalAlertsList {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
