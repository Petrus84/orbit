}

.statusDanger {
  color: var(--red-text);
}

.statusNeutral {
  color: var(--text-muted);
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVIDADE E ACESSIBILIDADE
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .panel,
