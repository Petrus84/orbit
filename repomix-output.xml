<file path="scripts/seed-dynamic.ts">
/* ==========================================================================
   ORBIT · Infrastructure — Dynamic Provisioning & Seeder Engine (v2.4.0)
   Caminho: scripts/seed-dynamic.ts
   Responsabilidade: Escanear as pastas locais, cadastrar automaticamente
   agências, clientes e leads novos na nuvem do Supabase de uma só vez.

   ✅ CORREÇÕES v2.4.0 (alinhado ao DDL real):
   - ❌ REMOVIDO: campo `email` no upsert de `agencies` — essa coluna NÃO
     existe na tabela `agencies` (ver sql_de_criacao.pdf, seção 3). O insert
     anterior falhava com "column agencies.email does not exist".
   - ⚠️ AJUSTE: onConflict de `clients` trocado de
     'agency_id,instagram_account_id' (sem UNIQUE constraint no DDL) para
     'id' simples — evita erro "no unique or exclusion constraint matching
     ON CONFLICT specification". O vínculo com cliente existente passa a
     depender do CLIENT_TEST_ID fixo ou de um novo UUID gerado pelo banco.
   ========================================================================== */

import dotenv from 'dotenv'
dotenv.config({ path: '.env.local' })

import fs from 'fs'
import path from 'path'
import process from 'process'
import { createClient } from '@supabase/supabase-js'

// ─────────────────────────────────────────────────────────────────────────
// Paths via .env.local
// ─────────────────────────────────────────────────────────────────────────

const PASTA_CLIENTES = process.env.PASTA_OPERATIONAL ?? ''
const PASTA_LEADS = process.env.PASTA_LEAD ?? ''

if (!PASTA_CLIENTES || !PASTA_LEADS) {
  console.error('\n🚨 ERRO CRÍTICO DE AMBIENTE:')
  console.error('   PASTA_OPERATIONAL e PASTA_LEAD são obrigatórias no .env.local')
  console.error('   Exemplo:')
  console.error('   PASTA_OPERATIONAL=C:/Users/DELL/Projetos/Alpha_Coleta/clientes')
  console.error('   PASTA_LEAD=C:/Users/DELL/Projetos/Alpha_Coleta/leads\n')
  process.exit(1)
}

// IDs Padrão de Homologação (Base Produção)
// ─── CONTRATO DE IDENTIDADES DE HOMOLOGAÇÃO (DDD) ──────────────────────────
const METODO75_AGENCY_ID = '11111111-1111-1111-1111-111111111111';

const DOMAIN_CLIENT_MAP: Record<string, string> = {
  'cpimportstore': '22222222-2222-2222-2222-222222222222',
  'eupetruchio84': '24140477-0c82-4fda-83df-958377f105ff',
};


// ─────────────────────────────────────────────────────────────────────────
// Validação de variáveis de ambiente do Supabase
// ─────────────────────────────────────────────────────────────────────────

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || ''
const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY || ''

if (!supabaseUrl || !supabaseServiceKey) {
  console.error('\n🚨 ERRO CRÍTICO DE AMBIENTE:')
  console.error('   As variáveis NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY')
  console.error('   são obrigatórias no escopo do processo do terminal.\n')
  process.exit(1)
}

// Instanciação administrativa master para bypassar as restrições de RLS do banco
const supabase = createClient(supabaseUrl, supabaseServiceKey)

// ─────────────────────────────────────────────────────────────────────────
// FUNÇÃO PRINCIPAL: Dynamic Seeder
// ─────────────────────────────────────────────────────────────────────────

async function dynamicSeeder() {
  console.log('\n====== 🚀 ORBIT DYNAMIC PROVISIONING ENGINE ======')

  try {

    // ─── PASSO 1: PROVISIONAR A AGÊNCIA MESTRE DE TESTES ───────────────────
    console.log('🏢 Validando Agência Mestre de Homologação...')
    const { error: agencyError } = await supabase
      .schema('orbit')
      .from('agencies')
      .upsert({
        id: METODO75_AGENCY_ID,
        name: 'Alpha Agência Digital Mestre',
        // ✅ CORREÇÃO v2.3.0: campo `email` removido — não existe no DDL
        // (tabela `agencies` só tem id, name, created_at, updated_at)
      }, { onConflict: 'id' })

    if (agencyError) {
      throw new Error(`Falha crítica ao registrar agência: ${agencyError.message}`)
    }

    console.log('   ✅ Agência Mestre validada e pronta')

    // ─── PASSO 2: ESCANEAR E CADASTRAR CLIENTES OPERACIONAIS ───────────────
    if (fs.existsSync(PASTA_CLIENTES)) {
      const subpastas = fs.readdirSync(PASTA_CLIENTES).filter((file: string) =>
        fs.statSync(path.join(PASTA_CLIENTES, file)).isDirectory()
      )

      console.log(`\n📂 Escaneando pasta de Clientes Operacionais... Encontradas: ${subpastas.length}`)

      for (const username of subpastas) {
        // Mapeamento semântico: extrai 'cpimportstore' caso a pasta seja o backup 'instagram-cpimportstore-...'
        let clientName = username
        if (username.startsWith('instagram-')) {
          const partes = username.split('-')
          if (partes.length > 1) {
            clientName = partes[1] ?? clientName // Pinça o handle do meio
          }
        }

        console.log(`👤 Provisionando Cliente Operacional real: ${clientName}...`)

        // Se for o cliente alvo padrão, força o ID estático de PRD para manter o vínculo
        const targetClientId = DOMAIN_CLIENT_MAP[clientName]

        const clientPayload = {
          ...(targetClientId && { id: targetClientId }),
          agency_id: METODO75_AGENCY_ID,
          name: `E-commerce ${clientName.toUpperCase()}`,
          handle: clientName, // 👈 Adicione esta linha exata
          instagram_account_id: clientName,
          is_business_account: true,
        }

        // ✅ CORREÇÃO v2.3.0: onConflict mudado de 'agency_id,instagram_account_id'
        // (sem UNIQUE constraint no DDL) para 'id'. Clientes sem targetClientId
        // geram um novo UUID a cada execução — aceitável em ambiente de
        // homologação, mas idealmente crie uma UNIQUE constraint real no banco
        // se precisar de idempotência por instagram_account_id.
        const { data: clientData, error: clientError } = await supabase
          .schema('orbit')
          .from('clients')
          .upsert(clientPayload, { onConflict: 'id' })
          .select('id, name')
          .single()

        if (clientError) {
          console.error(`   ❌ Falha ao sincronizar cliente ${clientName}:`, clientError.message)
        } else if (clientData) {
          console.log(`   ✅ Sincronizado! UUID na Nuvem: ${clientData.id} → ${clientData.name}`)
        }
      }
    } else {
      console.log(`\n⏭️  Pasta operacional de clientes não encontrada em: ${PASTA_CLIENTES}`)
    }

    // ─── PASSO 3: ESCANEAR E CADASTRAR LEADS DE PROSPECÇÃO COMERCIAL ───────
    if (fs.existsSync(PASTA_LEADS)) {
      const subpastasLeads = fs.readdirSync(PASTA_LEADS).filter((file: string) =>
        fs.statSync(path.join(PASTA_LEADS, file)).isDirectory()
      )

      console.log(`\n📂 Escaneando pasta de Leads de Vendas... Encontradas: ${subpastasLeads.length}`)

      for (const leadUsername of subpastasLeads) {
        console.log(`🎯 Canal de leads validado e pronto para receber arquivos de: @${leadUsername}`)
      }
    } else {
      console.log(`⏭️  Pasta comercial de leads não encontrada em: ${PASTA_LEADS}`)
    }

  } catch (err: unknown) {
    const msg = err instanceof Error ? err.message : String(err)
    console.error('\n🚨 CRÍTICO: Falha na esteira de provisionamento do SaaS:', msg)
  }

  console.log('\n====== 🏁 PROVISIONAMENTO CONCLUÍDO ======\n')
  process.exit(0)
}

// ─────────────────────────────────────────────────────────────────────────
// EXECUTAR
// ─────────────────────────────────────────────────────────────────────────

dynamicSeeder()
</file>

<file path="src/components/common/AlertCard.module.css">
/* ============================================================================
   AlertCard.module.css
   Reconstruído 14/08/2026 no padrão real do projeto (CSS Modules por
   componente), confirmado contra CriticalAlert.module.css — substitui a
   entrega anterior (alerts.css global, classes .alert/.alert-crit, tokens
   extraídos do protótipo HTML). Esse padrão anterior não é o que o projeto
   usa de verdade; REGRA-07/convenção real pede CSS Module por componente.

   TOKENS CONFIRMADOS (vistos literalmente em CriticalAlert.module.css):
     --space-1, --space-3, --space-4, --space-5
     --border-width, --border-default, --border-radius-lg
     --border-glow-red, --border-glow-gold, --border-glow-cyan
     --text-primary, --text-muted
     --font-size-lg, --font-size-sm, --font-size-xs
     --font-weight-bold

   TOKENS NÃO CONFIRMADOS (usados abaixo por necessidade — AlertCard tem
   mais elementos que CriticalAlert: métrica comparativa, botões, status).
   Marcados inline com ⚠️. Não vi nenhum arquivo que confirme o nome real
   destes — se o token real tiver outro nome, é achar-e-substituir, não
   reescrever a estrutura.
   FIX 09/09/2026 — rgba(255, 65, 54, ...) corrigido pra rgba(255, 68, 68, ...)
   em 4 ocorrências (.critical, .severityBadge.critical, .critical .btn).
   O valor antigo era um vermelho ligeiramente diferente do --red/--neon-red
   oficial (#FF4444 = rgb(255,68,68)) — drift confirmado contra o protótipo
   SSOT, provavelmente cópia manual desatualizada. Demais cores (gold, cyan,
   green) já batiam exatamente com os tokens, não precisaram de correção.
   ============================================================================ */

.card {
  position: relative;
  display: flex;
  gap: var(--space-4);
  border: var(--border-width) solid var(--border-default);
  border-radius: var(--border-radius-lg);
  padding: var(--space-4) var(--space-5);
  width: 100%;
}

.critical {
  background: linear-gradient(135deg, rgba(255, 68, 68, 0.08), rgba(255, 68, 68, 0.03));
  border-color: var(--border-glow-red);
  box-shadow: 0 0 24px rgba(255, 68, 68, 0.1);
}

.warning {
  background: linear-gradient(135deg, rgba(255, 195, 0, 0.08), rgba(255, 195, 0, 0.03));
  border-color: var(--border-glow-gold);
  box-shadow: 0 0 24px rgba(255, 195, 0, 0.1);
}

.info {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.06), rgba(0, 255, 255, 0.02));
  border-color: var(--border-glow-cyan);
  box-shadow: 0 0 24px rgba(0, 255, 255, 0.08);
}

/* ✅ ADICIONADO 07/09 — AlertSeverity inclui 'success' (orbit.ts), mas o
   módulo só cobria critical/warning/info. Usa --green (SSOT), não uma
   nova cor fora da paleta. */
.success {
  background: linear-gradient(135deg, rgba(46, 204, 113, 0.08), rgba(46, 204, 113, 0.03));
  border-color: var(--green);
  box-shadow: 0 0 24px rgba(46, 204, 113, 0.1);
}
.success .btn {
  background: rgba(46, 204, 113, 0.12);
  border-color: var(--green);
  color: var(--text-primary);
}

.icon {
  font-size: var(--font-size-lg);
  flex-shrink: 0;
  margin-top: 1px;
}

.body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

/* ✅ ADICIONADO 07/09 — linha título + timestamp (padrão .row-between do
   protótipo, aplicado como CSS Module em vez de classe global). */
.headerRow {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
}

/* ✅ ADICIONADO 08/09 — agrupa título + badge de severidade no cabeçalho,
   paridade com `row-between mb8` (alert-title + badge-red/amber) do
   protótipo. */
.titleGroup {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  min-width: 0;
}

/* Badge pequeno — cores próprias, não reaproveita o gradiente/glow de
   .critical/.warning/.info/.success (feitos para o card inteiro; um glow
   de 24px numa pill de texto pequena borra o contorno). */
.severityBadge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: 1px var(--space-3);
  border-radius: var(--radius-lg);
  border: var(--border-width) solid;
  background: none;
  box-shadow: none;
}

.severityBadge.critical {
  color: var(--red-text); /* FIX (19/09/2026): hex cru #ff8080 voltou numa edição posterior — reaplicado o token */
  border-color: var(--border-glow-red);
  background: rgba(255, 68, 68, 0.15);
}
.severityBadge.warning {
  color: var(--amber);
  border-color: var(--border-glow-gold);
  background: rgba(255, 195, 0, 0.12);
}
.severityBadge.info {
  color: var(--blue-text); /* FIX (19/09/2026): hex cru #7eb3ff voltou numa edição posterior — reaplicado o token */
  border-color: var(--border-glow-cyan);
  background: rgba(0, 255, 255, 0.1);
}
.severityBadge.success {
  color: var(--green);
  border-color: var(--green);
  background: rgba(46, 204, 113, 0.12);
}

.timestamp {
  flex-shrink: 0;
  font-family: var(--mono);
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  white-space: nowrap;
}

.title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.text {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  line-height: 1.5;
}

/* ✅ ADICIONADO (P0 — v8.2): fileira de chips de contexto (métrica,
   natureza, confiança). Mesma lógica visual do .severityBadge (pill
   pequena, sem o glow de 24px do card inteiro), mas neutra — não é um
   indicador de severidade, é metadado de proveniência do alerta. */
.chipRow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-top: var(--space-1);
}

.chip {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: 1px var(--space-3);
  border-radius: var(--border-radius-lg);
  border: var(--border-width) solid var(--border-default);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-muted);
  white-space: nowrap;
}

/* natureza: 'tecnica' | 'comunicacao' — mesma paleta cyan do .info, mas
   sem glow (é rótulo de metadado, não status de alerta). */
.chipNatureza {
  border-color: var(--border-glow-cyan);
  color: var(--blue-text); /* FIX (19/09/2026): novo desde a última rodada — nasceu com hex cru #7eb3ff em vez do token, mesmo drift dos outros dois badges */
  background: rgba(0, 255, 255, 0.06);
}

/* confidence_level: L0/L1/L2 — FIX (19/09/2026): as cores estavam na
   direção errada (L2 verde/melhor, L0 neutro/pior). Confirmado contra
   contentContractEngine.ts (15+ usos: L0 = dado real/direto, L2 = fallback
   sem breakdown ou amostra insuficiente) e contra KPICard.tsx (L0 sempre
   foi verde ali). L0 = Medido (melhor) → verde. L1 = Estimado → âmbar.
   L2 = Hipótese (pior) → neutro, sem alarmar como se fosse erro. */
.chipConfidenceL0 {
  border-color: var(--green);
  color: var(--green);
  background: rgba(46, 204, 113, 0.1);
}
.chipConfidenceL1 {
  border-color: var(--border-glow-gold);
  color: var(--amber);
  background: rgba(255, 195, 0, 0.1);
}
.chipConfidenceL2 {
  border-color: var(--border-default);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.04);
}

/* ⚠️ --space-2 não confirmado — usei --space-1 (confirmado) como aproximação
   conservadora até alguém confirmar se --space-2 existe de verdade. */
.meta {
  margin-top: var(--space-3);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--border-radius-lg);
  background: rgba(0, 0, 0, 0.25);
