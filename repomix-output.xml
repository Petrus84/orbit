.pctLabel {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin: 0;
}

/* ============================================================================
   BANNERS
   ============================================================================ */
.bannerError {
  border-radius: 0.5rem;
  border: 1px solid var(--border-glow-red);
  background-color: rgba(255, 68, 68, 0.2);
  padding: 1rem;
  color: var(--red-text);
  font-size: 0.875rem;
}

.bannerSuccess {
  border-radius: 0.5rem;
  border: 1px solid var(--border-glow-green);
  background-color: rgba(46, 204, 113, 0.2);
  padding: 1rem;
  color: color-mix(in srgb, var(--green) 70%, white);
  font-size: 0.875rem;
}

/* ============================================================================
   LOADING
   ============================================================================ */
.loading {
  border-radius: 0.5rem;
  border: 1px solid var(--line);
  background-color: rgba(31, 31, 40, 0.3);
  padding: 1.5rem;
  text-align: center;
  color: var(--text-muted);
}

.empty {
  color: var(--text-muted);
}

/* ============================================================================
   SECTIONS
   ============================================================================ */
.sections {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.card {
  border-radius: 0.5rem;
  border: 1px solid var(--line);
  background-color: rgba(31, 31, 40, 0.3);
  padding: 1.5rem;
}

.sectionTitle {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 1rem 0;
}

.idx {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 50%;
  background-color: rgba(0, 255, 255, 0.2);
  font-size: 0.75rem;
  font-family: "Monaco", "Courier New", monospace;
  color: var(--neon-cyan);
}

/* ============================================================================
   GRID & SPACING
   ============================================================================ */
.grid2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.fieldGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

.spaceY {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.spaceY > div {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* ============================================================================
   FORM FIELDS
   ============================================================================ */
.field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.field > label,
.card :global(dt) {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-secondary);
}

.help {
  font-size: 0.75rem;
  color: var(--text-dim);
  margin: 0.25rem 0 0 0;
}

.input,
.select,
.textarea {
  border-radius: 0.375rem;
  border: 1px solid var(--line);
  background-color: var(--bg1);
  padding: 0.5rem 0.75rem;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.875rem;
  transition: border-color 0.2s ease;
}

.input:focus,
.select:focus,
.textarea:focus {
  outline: none;
  border-color: var(--neon-cyan);
  box-shadow: 0 0 0 2px rgba(0, 255, 255, 0.1);
}

.textarea {
  resize: vertical;
  min-height: 4rem;
}

.disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.card :global(dd) {
  color: var(--text-primary);
  margin: 0;
}

/* ============================================================================
   REPEATABLE ROWS
   ============================================================================ */
.repRows {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}

.repRow {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 0.5rem;
  align-items: flex-end;
}

/* ✅ FIX (integração 12/09/2026): existia no CSS original mas nunca era
   aplicada no JSX (só .repRow sozinho) — a linha do Schwartz tem 4 campos
   (chave, valor, prioridade, remover), não 3, e quebrava o grid. Ver
   renderSchwartzEditor() no OnboardingScreen.tsx. */
.repRow.schwartz {
  grid-template-columns: 1fr 1fr 120px auto;
}

@media (max-width: 640px) {
  .repRow.schwartz {
    grid-template-columns: 1fr 1fr;
  }
}

.btnRemove {
  border-radius: 0.375rem;
  background-color: rgba(255, 68, 68, 0.3);
  border: 1px solid rgba(255, 68, 68, 0.5);
  padding: 0.5rem 0.75rem;
  color: var(--red-text);
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btnRemove:hover {
  background-color: rgba(255, 68, 68, 0.5);
}

.btnAdd {
  border-radius: 0.375rem;
  background-color: var(--bg1);
  border: 1px solid var(--line);
  padding: 0.5rem 0.75rem;
  color: var(--text-secondary);
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btnAdd:hover {
  background-color: var(--bg3);
  border-color: var(--line2);
}

/* ============================================================================
   PILLS & LINKS
   ============================================================================ */
.pillList {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  border-radius: 9999px;
  background-color: rgba(0, 255, 255, 0.2);
  padding: 0.375rem 0.75rem;
  font-size: 0.875rem;
  color: var(--neon-cyan);
  text-decoration: none;
  transition: all 0.2s ease;
}

.pill:hover {
  background-color: rgba(0, 255, 255, 0.3);
}

/* ============================================================================
   AUDIENCE METER
   ============================================================================ */
.audMeterWrap {
  margin-top: 1rem;
}

.audMeter {
  display: flex;
  height: 0.5rem;
  border-radius: 9999px;
  overflow: hidden;
  background-color: var(--bg3);
  margin-bottom: 0.5rem;
}

.audMeter > div {
  transition: width 0.3s ease;
}

.audLabel {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin: 0;
}

/* ============================================================================
   SUM CHECK
   ============================================================================ */
.sumCheck {
  margin-top: 1rem;
  padding: 1rem;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  transition: all 0.2s ease;
}

.sumCheck.empty {
  background-color: rgba(31, 31, 40, 0.3);
  border: 1px solid var(--line);
  color: var(--text-muted);
}

.sumCheck.ok {
  background-color: rgba(46, 204, 113, 0.2);
  border: 1px solid var(--border-glow-green);
  color: color-mix(in srgb, var(--green) 70%, white);
}

.sumCheck.bad {
  background-color: rgba(255, 68, 68, 0.2);
  border: 1px solid var(--border-glow-red);
  color: var(--red-text);
}

/* ============================================================================
   ACTIONS
   ============================================================================ */
.actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.btnPrimary,
.btnGhost {
  border-radius: 0.375rem;
  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.btnPrimary {
  background-color: var(--neon-cyan);
  color: var(--bg);
}

.btnPrimary:hover:not(:disabled) {
  background-color: color-mix(in srgb, var(--neon-cyan) 75%, black);
}

.btnPrimary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btnGhost {
  background-color: transparent;
  border: 1px solid var(--line);
  color: var(--text-secondary);
}

.btnGhost:hover {
  background-color: var(--bg3);
  border-color: var(--line2);
}

/* ============================================================================
   LOG PANEL
   ============================================================================ */
.logPanel {
  border-radius: 0.5rem;
  border: 1px solid var(--line);
  background-color: rgba(31, 31, 40, 0.3);
  padding: 1rem;
  cursor: pointer;
}

.logPanel[open] {
  padding-bottom: 1rem;
}

.logSummary {
  font-weight: 500;
  color: var(--text-secondary);
  user-select: none;
}

.logContent {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.logEmpty {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin: 0;
}

.logEntry {
  border-left: 2px solid var(--line);
  padding-left: 0.75rem;
  font-size: 0.875rem;
}

.logEntry time {
  display: block;
  color: var(--text-muted);
  font-family: "Monaco", "Courier New", monospace;
  font-size: 0.75rem;
  margin-bottom: 0.25rem;
}

.logEntry span {
  color: var(--text-secondary);
  font-weight: 500;
}

.logEntry div {
  color: var(--text-primary);
  margin-top: 0.25rem;
}

/* ============================================================================
   LABEL (para Schwartz)
   ============================================================================ */
.label {
  display: inline-block;
  margin-bottom: 0.375rem;
  padding: 0.25rem 0.5rem;
  border-radius: 0.25rem;
  background-color: rgba(31, 31, 40, 0.5);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ============================================================================
   RESPONSIVE
   ============================================================================ */
@media (max-width: 768px) {
  .container {
    padding: 1rem;
    gap: 1rem;
  }
  .repRow,
  .repRowSchwartz {
    grid-template-columns: 1fr;
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .completeness {
    text-align: left;
  }

  .grid2 {
    grid-template-columns: 1fr;
  }

  .repRow,
  .repRow.schwartz {
    grid-template-columns: 1fr;
  }

  .title {
    font-size: 1.5rem;
  }

  .sectionTitle {
    font-size: 1rem;
  }
}

@media (max-width: 480px) {
  .container {
    padding: 0.75rem;
    gap: 0.75rem;
  }

  .card {
    padding: 1rem;
  }

  .actions {
    flex-direction: column;
  }

  .btnPrimary,
  .btnGhost {
    width: 100%;
  }

  .pct {
    font-size: 1.5rem;
  }

  .title {
    font-size: 1.25rem;
  }
}

/* ============================================================================
   PRINT
   ============================================================================ */
@media print {
  .actions,
  .logPanel {
    display: none;
  }

  .card {
    page-break-inside: avoid;
  }
}

/* troca .repRow.schwartz */
.repRowSchwartz {
  grid-template-columns: 1fr 1fr 120px auto;
}

@media (max-width: 640px) {
  .repRowSchwartz {
    grid-template-columns: 1fr 1fr;
  }
}

/* troca .sumCheck.empty / .ok / .bad */
.sumCheckEmpty {
  background-color: color-mix(in srgb, var(--bg3) 30%, transparent);
  border: 1px solid var(--line);
  color: var(--text-muted);
}

.sumCheckOk {
  background-color: rgba(46, 204, 113, 0.2);
  border: 1px solid var(--border-glow-green);
  color: color-mix(in srgb, var(--green) 70%, white);
}

.sumCheckBad {
  background-color: rgba(255, 68, 68, 0.2);
  border: 1px solid var(--border-glow-red);
  color: var(--red-text);
}

.wrapper {
  width: min(100%, 760px);
  margin: 0 auto;
}

.container {
  width: 100%;
  box-sizing: border-box;
}

.progress {
  display: grid;
  width: 3.5rem;
  aspect-ratio: 1;
  place-items: center;
  border: 2px solid var(--neon-cyan);
  border-radius: 50%;
  color: var(--neon-cyan);
  font-weight: 700;
}

.progressValue {
  font-variant-numeric: tabular-nums;
}

.progressBar {
  height: 0.4rem;
  overflow: hidden;
  border-radius: 999px;
  background: var(--bg3);
}

.progressFill {
  height: 100%;
  border-radius: inherit;
  background: var(--neon-cyan);
  transition: width 220ms ease;
}

.cardTitle {
  margin: 0;
  color: var(--text-primary);
  font-size: 1.25rem;
}

.cardDescription {
  margin: 0.35rem 0 1.25rem;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.fieldsContainer {
  display: grid;
  gap: 1.25rem;
}

.fieldWrapper {
  display: grid;
  min-width: 0;
  gap: 0.55rem;
}

.labelContainer {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.label {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--text-secondary);
  font-size: 0.875rem;
  text-transform: none;
  letter-spacing: 0;
}

.required,
.alertIcon,
.errorIcon {
  color: var(--red-text);
}

.fieldsContainer .input,
.fieldsContainer .textarea {
  width: 100%;
  box-sizing: border-box;
}

.inputError {
  border-color: var(--red-text) !important;
}

.errorText {
  margin: 0.35rem 0 0;
  color: var(--red-text);
  font-size: 0.8rem;
}

.radioGroup,
.checkboxGroup {
  display: grid;
  gap: 0.5rem;
}

.radioLabel,
.checkboxLabel {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.radioInput,
.checkboxInput {
  accent-color: var(--neon-cyan);
}

.tooltipWrapper {
  position: relative;
  display: inline-flex;
  color: var(--text-muted);
  cursor: help;
}

.helpIcon {
  width: 1rem;
  height: 1rem;
}

.tooltip {
  position: absolute;
  z-index: 2;
  bottom: calc(100% + 0.45rem);
  left: 50%;
  width: max-content;
  max-width: min(16rem, 80vw);
  visibility: hidden;
  border: 1px solid var(--line);
  border-radius: 0.35rem;
  background: var(--bg1);
  padding: 0.5rem 0.65rem;
  color: var(--text-primary);
  font-size: 0.75rem;
  transform: translateX(-50%);
}

.tooltipWrapper:hover .tooltip,
.tooltipWrapper:focus-within .tooltip {
  visibility: visible;
}

.fieldInsight {
  display: flex;
  align-items: flex-start;
  gap: 0.45rem;
  color: var(--text-muted);
  font-size: 0.78rem;
  line-height: 1.45;
}

.fieldInsightIcon {
  width: 1rem;
  height: 1rem;
  flex: 0 0 auto;
  color: var(--neon-cyan);
}

.insightCard {
  border: 1px solid var(--line);
  border-left: 3px solid var(--neon-cyan);
  border-radius: 0.4rem;
  background: var(--bg1);
  padding: 1rem 1.1rem;
}

.insightHeader {
  display: flex;
  align-items: center;
  gap: 0.55rem;
}

.insightIcon {
  width: 1.1rem;
  height: 1.1rem;
  color: var(--neon-cyan);
}

.insightTitle {
  margin: 0;
  color: var(--text-primary);
  font-size: 0.95rem;
}

.insightText,
.insightSource {
  margin: 0.6rem 0 0;
  color: var(--text-secondary);
  font-size: 0.82rem;
  line-height: 1.5;
}

.insightSource {
  color: var(--text-muted);
  font-size: 0.72rem;
}

.buttonGroup {
  display: flex;
  justify-content: space-between;
  gap: 0.75rem;
}

.buttonPrimary,
.buttonSecondary {
  display: inline-flex;
  min-height: 2.75rem;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border: 1px solid transparent;
  border-radius: 0.35rem;
  padding: 0.65rem 1rem;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}

.buttonPrimary {
  background: var(--neon-cyan);
  color: var(--bg);
}

.buttonPrimary:disabled,
.buttonSecondary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.buttonSecondary {
  border-color: var(--line);
  background: transparent;
  color: var(--text-secondary);
}

.buttonSecondary:hover:not(:disabled) {
  background: var(--bg3);
}

.chevronIcon,
.loaderIcon,
.messageIcon {
  width: 1rem;
  height: 1rem;
  flex: 0 0 auto;
}

.loadingState,
.errorState {
  display: flex;
  min-height: 10rem;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  color: var(--text-muted);
}

.message {
  display: flex;
  align-items: flex-start;
  gap: 0.55rem;
  border: 1px solid var(--line);
  border-radius: 0.35rem;
  padding: 0.75rem 0.9rem;
  font-size: 0.875rem;
}

.messageError {
  border-color: var(--border-glow-red);
  background: rgba(255, 68, 68, 0.12);
  color: var(--red-text);
}

.messageWarning {
  border-color: rgba(245, 158, 11, 0.55);
  background: rgba(245, 158, 11, 0.1);
  color: var(--text-primary);
}

@media (max-width: 480px) {
  .header {
    gap: 0.75rem;
  }

  .buttonGroup {
    flex-direction: column-reverse;
  }

  .buttonPrimary,
  .buttonSecondary {
    width: 100%;
  }
}
</file>

<file path="components/screens/OnboardingScreen.tsx">
'use client'

import React, { useState, useCallback } from 'react'
import { ChevronRight, AlertCircle, HelpCircle, Loader, Lightbulb } from 'lucide-react'
import { useOnboarding } from '@/hooks/useOnboarding'
import { validateAudienceSum, validatePercentage } from '@/lib/onboarding/enums'
import {
  ENUM_TOTAL_FOLLOWERS_SOURCE,
  ENUM_CTA_TYPE,
  ENUM_FUNNEL_MATURITY,
  ENUM_SETOR_BENCHMARK,
  ENUM_PROOF_MECHANISM,
  ENUM_VALUES_AFFECT_SOURCE,
  ENUM_CONFIDENCE,
  ENUM_GENDER_CATEGORY,
  CURIOSIDADES_POR_SETOR,
} from '@/lib/onboarding/enums'
import type { ClientOnboarding, SetorBenchmark } from '@/types/orbit'
import styles from './OnboardingScreen.module.css'

// ============================================================================
// TIPOS
// ============================================================================

interface CampoConfig {
  id: keyof FormAnswers
  label: string
  tipo: 'text' | 'number' | 'select' | 'checkbox' | 'textarea' | 'radio' | 'url'
  placeholder?: string
  tooltip?: string
  insight?: string // Dado setorial contextual
  step?: string
  opcoes?: { valor: string; label: string }[]
  validacao?: (valor: unknown) => { ok: boolean; erro?: string }
  alerta?: boolean
  obrigatorio?: boolean
}

interface Fase {
  id: string
  titulo: string
  descricao: string
  campos: CampoConfig[]

}


// ============================================================================
// FASES DO ONBOARDING COM INSIGHTS
// ============================================================================

const FASES: Fase[] = [
  {
    id: 'info_basica',
    titulo: 'Informações Básicas',
    descricao: 'Vamos começar com o essencial sobre sua conta',
    campos: [
      {
        id: 'total_followers',
        label: 'Total de seguidores',
        tipo: 'number',
        placeholder: '15000',
        obrigatorio: true,
        insight: 'O Brasil tem 150M usuários ativos em redes (70% da população). Seu tamanho ajuda a calibrar benchmarks.',
        validacao: (v) => {
          if (!v) return { ok: false, erro: 'Campo obrigatório' }
          const num = Number(v)
          if (!Number.isInteger(num) || num <= 0) {
            return { ok: false, erro: 'Deve ser um número inteiro maior que 0' }
          }
          return { ok: true }
        },
      },
      {
        id: 'total_followers_source',
        label: 'Fonte da informação',
        tipo: 'select',
        obrigatorio: true,
        opcoes: ENUM_TOTAL_FOLLOWERS_SOURCE.map(([v, l]) => ({ valor: v, label: l })),
        insight: 'Dados confirmados (print/scrape) são mais confiáveis que estimativas para benchmarking.',
        validacao: (v) => ({
          ok: !!v,
          erro: v ? undefined : 'Selecione uma fonte',
        }),
      },
    ],
  },
  {
    id: 'negocio',
    titulo: 'Seu Negócio',
    descricao: 'Categoria e modelo de monetização',
    campos: [
      {
        id: 'setor_benchmark',
        label: 'Setor / Benchmark',
        tipo: 'select',
        obrigatorio: true,
        opcoes: ENUM_SETOR_BENCHMARK.map(([v, l]) => ({ valor: v, label: l })),
        insight: 'Cada setor monetiza diferente. Comércio direto mede conversão; infoproduto mede lançamento; serviços medem lead.',
        validacao: (v) => ({
          ok: !!v,
          erro: v ? undefined : 'Selecione um setor',
        }),
      },
      {
        id: 'nicho',
        label: 'Nicho específico',
        tipo: 'text',
        placeholder: 'Ex: Marketing digital, gestão de tráfego...',
        tooltip: 'Nichos específicos convertem melhor que genéricos',
        insight: 'Nichos específicos (ex: "gestão de tráfego para clínicas") tendem a funcionar melhor que temas genéricos.',
      },
      {
        id: 'cta_type',
        label: 'Call-to-action principal',
        tipo: 'select',
        opcoes: ENUM_CTA_TYPE.map(([v, l]) => ({ valor: v, label: l })),
        insight: 'Link direto e WhatsApp são os CTAs mais comuns no Brasil para comércio direto.',
      },
    ],
  },
  {
    id: 'audiencia',
    titulo: 'Sua Audiência',
    descricao: 'Segmentação em % (soma deve ser ~100%)',
    campos: [
      {
        id: 'audience_nucleo_fiel_pct',
        label: 'Núcleo fiel (compra regularmente) %',
        tipo: 'number',
        placeholder: '30',
        step: '0.1',
        tooltip: 'Seu core de clientes leais',
        insight: 'Núcleo fiel é o segmento mais valioso — gera receita recorrente e recomendações.',
        validacao: validatePercentage,
      },
      {
        id: 'audience_consumo_passivo_pct',
        label: 'Consumo passivo (vê, não compra) %',
        tipo: 'number',
        placeholder: '40',
        step: '0.1',
        tooltip: 'Inspiração, curiosidade',
        insight: 'Consumo passivo é seu funil de topo — alimenta o núcleo fiel com conteúdo educativo.',
        validacao: validatePercentage,
      },
      {
        id: 'audience_curiosidade_externa_pct',
        label: 'Curiosidade externa (descobriu recentemente) %',
        tipo: 'number',
        placeholder: '20',
        step: '0.1',
