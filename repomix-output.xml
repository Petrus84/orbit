const MIN_POSTS_CADENCE = 3;
const MS_PER_DAY = 86_400_000;

// Cadência no span ativo — MESMA definição da view v_benchmark_cadence_by_segment
// (colunas *_posts_per_week): posts por semana entre o primeiro e o último post,
// só com base mínima (>= 5 posts e >= 28 dias entre primeiro e último). Conta e
// referência precisam usar a mesma régua; o período selecionado continua valendo
// para nPosts/mix, mas não entra nesta taxa.
export const MIN_POSTS_ACTIVE_SPAN = 5;
export const MIN_ACTIVE_SPAN_DAYS = 28;

// 'YYYY-MM-DD' (UTC) de um timestamp ISO, ou null se não for parseável.
function isoDay(iso: string | null | undefined): string | null {
  if (!iso) return null;
  const day = iso.slice(0, 10);
  return /^\d{4}-\d{2}-\d{2}$/.test(day) ? day : null;
}

function dayDiff(fromDay: string, toDay: string): number {
  return Math.round(
    (Date.parse(`${toDay}T00:00:00Z`) - Date.parse(`${fromDay}T00:00:00Z`)) /
      MS_PER_DAY,
  );
}

interface ActiveSpanFields {
  activeSpanDays: number | null;
  postsPerWeekActive: number | null;
  weeksPerPostActive: number | null;
  firstPostOn: string | null;
  lastPostOn: string | null;
  collectedOn: string | null;
  daysLastPostToCollection: number | null;
}

// collectedAt = data em que os posts da conta foram coletados (âncora da
// recência). Nunca usar a data de hoje/fim do período: o dado só fala até a coleta.
function computeActiveSpan(
  publishedAt: string[],
  collectedAt: string | null | undefined,
): ActiveSpanFields {
  const days = publishedAt
    .map(isoDay)
    .filter((d): d is string => d !== null)
    .sort();
  const firstPostOn = days[0] ?? null;
  const lastPostOn = days[days.length - 1] ?? null;
  const spanDays =
    firstPostOn !== null && lastPostOn !== null
      ? dayDiff(firstPostOn, lastPostOn)
      : null;
  const eligible =
    spanDays !== null &&
    days.length >= MIN_POSTS_ACTIVE_SPAN &&
    spanDays >= MIN_ACTIVE_SPAN_DAYS;
  const collectedOn = isoDay(collectedAt);
  return {
    activeSpanDays: spanDays,
    postsPerWeekActive:
      eligible && spanDays !== null ? days.length / (spanDays / 7) : null,
    weeksPerPostActive:
      eligible && spanDays !== null ? spanDays / 7 / days.length : null,
    firstPostOn,
    lastPostOn,
    collectedOn,
    daysLastPostToCollection:
      lastPostOn !== null && collectedOn !== null
        ? dayDiff(lastPostOn, collectedOn)
        : null,
  };
}

export function computePostingCadence(
  publishedAt: string[],
  windowStart: string,
  windowEnd: string,
  collectedAt?: string | null,
): PostingCadence {
  const days = (Date.parse(windowEnd) - Date.parse(windowStart)) / MS_PER_DAY;
  const nPosts = publishedAt.length;
  const validDays = Number.isFinite(days) && days > 0;
  const active = computeActiveSpan(publishedAt, collectedAt);
  if (!validDays || nPosts < MIN_POSTS_CADENCE) {
    return {
      postsPerWeek: null,
      nPosts,
      windowDays: validDays ? days : 0,
      reason: "sem_base",
      weeksPerPost: null,
      ...active,
    };
  }
  const perWeek = nPosts / (days / 7);
  return {
    postsPerWeek: perWeek,
    nPosts,
    windowDays: days,
    reason: "ok",
    weeksPerPost: 1 / perWeek,
    ...active,
  };
}

export function computeFormatMix(formats: (string | null)[]): FormatMix | null {
  const total = formats.length;
  if (total === 0) return null;
  const counts = new Map<string, number>();
  for (const f of formats) {
    const key = f ?? "sem_formato";
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
  const items = [...counts.entries()]
    .map(([format, count]) => ({ format, count, pct: (count / total) * 100 }))
    .sort((a, b) => b.count - a.count);
  return { total, items };
}
