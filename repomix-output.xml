}

/* ═══════════════════════════════════════════════════════════════
   TÍTULO DO PAINEL
   ═══════════════════════════════════════════════════════════════ */

.panelTitle {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--neon-cyan);
  text-transform: uppercase;
