   Resumo de audiência: Alcance · Visitas · Cliques · Gênero · Cidades
   Versão: 1.3.0  |  Data: 2026-10-20

   MUDANÇA v1.1.0 (SSOT Compliance — alinhado ao QualityScoresPanel v1.0.3):
- Removidos TODOS os valores hardcoded rgba/gradientes
- Cores via tokens: --color-*-rgb + --opacity-*, --gradient-*, --shadow-*
- `transition: all` substituído por propriedades explícitas
- Regras duplicadas (barras de gênero, dots, sheen) consolidadas
- Adicionados hover com elevação, prefers-reduced-motion e focus-visible
- Fonte mono: --mono (mesmo token do QualityScoresPanel)

   MUDANÇA v1.2.0 (zero preenchimento sólido):
- Barras e dots de gênero agora são tint translúcido (color-mix) + borda,
     mesmo padrão do bottleneck-* do FunnelResult
- Removido --gradient-sheen (não é mais necessário)

   MUDANÇA v1.3.0 (Integração GAP Analysis - Opção C):
- Adicionada seção `.gapSection` e seus sub-componentes.
- Barras de GAP (.barFillReal, .barFillExpected) adotam a MESMA regra de
  "zero preenchimento sólido" da v1.2.0 (color-mix com hex variables nativas).
- Pista (track) hachurada incorporada para o "espaço restante".

   ⚠ TOKENS NOVOS A CRIAR NO SSOT (usados abaixo, ainda não existem):
- --color-pink-rgb:   255, 105, 180
- --color-blue-rgb:   74, 144, 255

   Design Logic:
- .panel: apenas layout (o GlassCard pai fornece o container/glow)
- .statsRow: 3 colunas (flex) — mesmo visual dos scoreBox cyan
- .genderBar: barra empilhada + legenda
- .citiesBlock: lista com ranking (nome + percentual)
- Tipografia: Sans para labels, Mono para números
   ========================================================================== */

/* ═══════════════════════════════════════════════════════════════
   PAINEL PRINCIPAL
   ═══════════════════════════════════════════════════════════════ */

.panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.panelTitle {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--neon-cyan);
  text-transform: uppercase;
  margin: 0;
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--line);
}

.blockLabel {
  font-family: var(--font-family);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--text-muted);
  letter-spacing: 0.05em;
  margin-bottom: var(--space-2);
  margin-top: 0;
}

/* ═══════════════════════════════════════════════════════════════
   STATS ROW (Alcance, Visitas, Cliques)
   ═══════════════════════════════════════════════════════════════ */

.statsRow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.stat {
  flex: 1;
  min-width: 120px;
  padding: var(--space-3);
  background: var(--gradient-cyan-subtle);
  border: 1px solid rgba(var(--color-cyan-rgb), var(--opacity-30));
  border-radius: var(--r8);
  box-shadow: var(--shadow-glow-cyan-inset);
  transition:
    transform var(--transition-fast),
    box-shadow var(--transition-fast),
    border-color var(--transition-fast),
    background var(--transition-fast);
}

.stat:hover {
  background: var(--gradient-cyan-hover);
  border-color: rgba(var(--color-cyan-rgb), var(--opacity-50));
  box-shadow: var(--shadow-glow-cyan-inset-hover);
  transform: translateY(-2px);
}

.statLabel {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: 0.03em;
  color: var(--text-muted);
  text-transform: uppercase;
  margin: 0 0 var(--space-2) 0;
}

.statValue {
  font-family: var(--mono);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--neon-cyan);
  line-height: 1;
  margin: 0;
}

/* ═══════════════════════════════════════════════════════════════
   GÊNERO — BARRA EMPILHADA
   ═══════════════════════════════════════════════════════════════ */

.genderBar {
  display: flex;
  width: 100%;
  height: 24px;
  background: transparent;
  border: 1px solid var(--line);
  border-radius: var(--r4);
  overflow: hidden;
}

/* Segmentos: tint translúcido + glow inset, sem fill sólido */
.genderBarFemale,
.genderBarMale {
  height: 100%;
  background: linear-gradient(
    180deg,
    color-mix(in srgb, rgb(var(--seg-rgb)) 25%, transparent),
    color-mix(in srgb, rgb(var(--seg-rgb)) 8%, transparent)
  );
  box-shadow: inset 0 0 12px
    color-mix(in srgb, rgb(var(--seg-rgb)) 16%, transparent);
  transition: width var(--transition-fast);
}

.genderBarFemale {
  --seg-rgb: var(--color-pink-rgb);
  border-right: 1px solid rgba(var(--seg-rgb), var(--opacity-50));
}

.genderBarMale {
  --seg-rgb: var(--color-blue-rgb);
}

/* ═══════════════════════════════════════════════════════════════
   GÊNERO — LEGENDA
   ═══════════════════════════════════════════════════════════════ */

.genderLegend {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.genderLegend span {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.dotFemale,
.dotMale {
  display: inline-block;
  flex-shrink: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: color-mix(in srgb, rgb(var(--seg-rgb)) 25%, transparent);
  border: 1px solid rgba(var(--seg-rgb), var(--opacity-50));
}

.dotFemale {
  --seg-rgb: var(--color-pink-rgb);
}

.dotMale {
  --seg-rgb: var(--color-blue-rgb);
}

/* ═══════════════════════════════════════════════════════════════
   CIDADES — RANKING
   ═══════════════════════════════════════════════════════════════ */

.citiesBlock {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: 1px solid rgba(var(--color-green-rgb), var(--opacity-30));
  border-radius: var(--r8);
  box-shadow: var(--shadow-glow-green-inset);
  margin-top: var(--space-4);
}

.citiesList {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.cityRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--line);
  font-size: var(--font-size-sm);
}

.cityRow:last-child {
  border-bottom: none;
}

.cityName {
  font-family: var(--font);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
}

.cityPct {
  min-width: 40px;
  font-family: var(--mono);
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  text-align: right;
}

/* ═══════════════════════════════════════════════════════════════
   GAP ANALYSIS (OPÇÃO C - DELTAS EM FOCO)
   ═══════════════════════════════════════════════════════════════ */

.gapSection {
  margin-top: var(--space-6);
  padding-top: var(--space-6);
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.gapCards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}

.metricCardReal,
.metricCardExpected {
  background-color: transparent;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* Efeito de tint no próprio card acompanhando a barra */
  background-image: linear-gradient(
    180deg,
    color-mix(in srgb, var(--card-glow) 5%, transparent),
    transparent
  );
  box-shadow: inset 0 2px 10px
    color-mix(in srgb, var(--card-glow) 5%, transparent);
}

.metricCardReal {
  --card-glow: var(--neon-green);
}

.metricCardExpected {
  --card-glow: var(--acc2);
}

.metricValue {
  font-family: var(--font-mono);
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-tight);
}

.metricLabel {
  font-family: var(--font-family);
  font-size: var(--font-size-xs);
  color: var(--text-dim);
  margin-top: var(--space-2);
  letter-spacing: 0.05em;
}

.metricCardReal .metricValue {
  color: var(--neon-green);
}
.metricCardExpected .metricValue {
  color: var(--acc2-text);
}

/* -- Badge de GAP -- */
.gapBadge {
  font-family: var(--font-family);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  text-align: center;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-pill);
  transition: var(--transition-base);
}

.gapBadge[data-status="positive"] {
  color: var(--neon-green);
  border: 1px solid color-mix(in srgb, var(--neon-green) 50%, transparent);
  box-shadow: var(--shadow-glow-green-inset);
  background: color-mix(in srgb, var(--neon-green) 5%, transparent);
}

.gapBadge[data-status="negative"] {
  color: var(--red-text);
  border: 1px solid color-mix(in srgb, var(--neon-red) 50%, transparent);
  box-shadow: var(--shadow-glow-red-inset);
  background: color-mix(in srgb, var(--neon-red) 5%, transparent);
}

/* -- Barras de Progresso Desacopladas (Translúcidas) -- */
.gapBarsContainer {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

.barGroup {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.barLabels {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
}

.textReal {
  color: var(--neon-green);
}
.textExpected {
  color: var(--acc2-text);
}
.textRest {
  color: var(--text-dim);
}

.barTrack {
  height: 12px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--line);
  background: transparent;
  overflow: hidden;
  position: relative;
  /* Striped pattern para simular a área "Restante" do protótipo */
  background-image: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 4px,
    rgba(255, 255, 255, 0.03) 4px,
    rgba(255, 255, 255, 0.03) 8px
  );
}

/* Efeito v1.2.0: Zero preenchimento sólido + Glassmorphism Glow */
.barFillReal,
.barFillExpected {
  height: 100%;
  border-radius: var(--radius-pill);
  transition: width var(--transition-slow);

  /* Fundo da trilha é escuro para não deixar vazar o striped pattern pelo vidro */
  background-color: var(--bg);

  /* Gradiente translúcido (TINT) por cima do background escuro */
  background-image: linear-gradient(
    180deg,
    color-mix(in srgb, var(--bar-color) 25%, transparent),
    color-mix(in srgb, var(--bar-color) 8%, transparent)
  );

  /* Glow interno e Borda de finalização */
  box-shadow: inset 0 0 12px
    color-mix(in srgb, var(--bar-color) 16%, transparent);
  border-right: 1px solid color-mix(in srgb, var(--bar-color) 50%, transparent);
}

.barFillReal {
  --bar-color: var(--neon-green);
}

.barFillExpected {
  --bar-color: var(--acc2);
}

/* ═══════════════════════════════════════════════════════════════
   EMPTY STATE
   ═══════════════════════════════════════════════════════════════ */

.emptyState {
  margin: 0;
  padding: var(--space-4);
  font-size: var(--font-size-sm);
  font-style: italic;
  color: var(--text-muted);
  text-align: center;
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVIDADE E ACESSIBILIDADE
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .stat,
  .genderBarFemale,
  .genderBarMale,
  .barFillReal,
  .barFillExpected,
  .gapBadge {
    transition: none;
  }

  .stat:hover {
    transform: none;
  }
}

.stat:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 1px;
}
</file>

<file path="components/content/AudienceSummaryPanel.tsx">
/* ==========================================================================
   ORBIT · Component — AudienceSummaryPanel
   Versão: 1.1.1  |  Data: 2026-10-19
   
   Atualizado para suportar a visualização de GAP (Opção C) cruzando o dado
   real (summary) com o esperado do onboarding (avatar_expected_gender_pct).
   ========================================================================== */

import { GlassCard } from "@/components/common/GlassCard";
import styles from "./AudienceSummaryPanel.module.css";
import type { AudienceSummary } from "@/types/orbit";
import type { Database } from "@/types/database.types";

export interface AudienceSummaryPanelProps {
  summary: AudienceSummary;
  // Novas propriedades mapeadas diretamente de client_onboarding
  expectedGenderCategory?: Database["orbit"]["Enums"]["gender_category"] | null;
  expectedGenderPct?: number | null;
}

function formatPct(value: number | null): string {
  return value != null ? `${value.toFixed(1)}%` : "—";
}

export function AudienceSummaryPanel({
  summary,
  expectedGenderCategory,
  expectedGenderPct,
}: AudienceSummaryPanelProps) {
  const hasGender =
    summary.genderFemalePct != null || summary.genderMalePct != null;
  const hasCities = summary.topCities.length > 0;

  // Lógica de cálculo do GAP
  let realGenderPct: number | null = null;
  let genderLabel = "Gênero";

  if (expectedGenderCategory === "female") {
    realGenderPct = summary.genderFemalePct ?? null;
    genderLabel = "Feminino";
  } else if (expectedGenderCategory === "male") {
    realGenderPct = summary.genderMalePct ?? null;
    genderLabel = "Masculino";
  }

  const hasGapData = realGenderPct != null && expectedGenderPct != null;
  const gapValue = hasGapData ? realGenderPct! - expectedGenderPct! : 0;
  const isPositiveGap = gapValue >= 0;

  return (
    <GlassCard glowColor="cyan" className={styles.panel}>
      <p className={styles.panelTitle}>AUDIÊNCIA — {summary.periodLabel}</p>

      {/* MÉTRICAS GERAIS (Mantido do original) */}
      <div className={styles.statsRow}>
        <div className={styles.stat}>
          <p className={styles.statLabel}>Alcance por seguidor</p>
          <p className={styles.statValue}>
            {formatPct(summary.reachFollowersPct)}
          </p>
        </div>
        <div className={styles.stat}>
          <p className={styles.statLabel}>Visitas ao perfil</p>
          <p className={styles.statValue}>{summary.profileVisits ?? "—"}</p>
        </div>
        <div className={styles.stat}>
          <p className={styles.statLabel}>Cliques no link</p>
          <p className={styles.statValue}>{summary.linkClicks ?? "—"}</p>
        </div>
      </div>

      {/* NOVA SESSÃO: GAP ANALYSIS (OPÇÃO C) */}
      {hasGapData && (
        <div className={styles.gapSection}>
          <p className={styles.blockLabel}>
            ANÁLISE DE ALINHAMENTO: {genderLabel.toUpperCase()}
          </p>

          <div className={styles.gapCards}>
            <div className={styles.metricCardReal}>
              <span className={styles.metricValue}>
                {realGenderPct?.toFixed(1)}%
              </span>
              <span className={styles.metricLabel}>REALIZADO</span>
            </div>
            <div className={styles.metricCardExpected}>
              <span className={styles.metricValue}>
                {expectedGenderPct?.toFixed(1)}%
              </span>
              <span className={styles.metricLabel}>ESPERADO</span>
            </div>
          </div>

          <div
            className={styles.gapBadge}
            data-status={isPositiveGap ? "positive" : "negative"}
          >
            GAP {gapValue > 0 ? "+" : ""}
            {gapValue.toFixed(1)}% /{" "}
            {isPositiveGap ? "Acima da Meta" : "Abaixo da Meta"}
          </div>

          <div className={styles.gapBarsContainer}>
            <div className={styles.barGroup}>
              <div className={styles.barLabels}>
                <span className={styles.textReal}>
                  Real: {realGenderPct?.toFixed(1)}%
                </span>
                <span className={styles.textRest}>
                  {(100 - realGenderPct!).toFixed(1)}% Restante
                </span>
              </div>
              <div className={styles.barTrack}>
                <div
                  className={styles.barFillReal}
                  style={{ width: `${realGenderPct}%` }}
                />
              </div>
            </div>

            <div className={styles.barGroup}>
              <div className={styles.barLabels}>
                <span className={styles.textExpected}>
                  Esperado: {expectedGenderPct?.toFixed(1)}%
                </span>
                <span className={styles.textRest}>
                  {(100 - expectedGenderPct!).toFixed(1)}% Restante
                </span>
              </div>
              <div className={styles.barTrack}>
                <div
                  className={styles.barFillExpected}
                  style={{ width: `${expectedGenderPct}%` }}
                />
              </div>
            </div>
          </div>
        </div>
      )}

      {/* SPLIT TRADICIONAL & CIDADES (Mantido) */}
      {hasGender && !hasGapData && (
        <div className={styles.genderBlock}>
          {" "}
          {/* Correção aplicada aqui (faltava o '<') */}
          <p className={styles.blockLabel}>GÊNERO</p>
          <div className={styles.genderBar}>
            {summary.genderFemalePct != null && (
              <div
                className={styles.genderBarFemale}
                style={{ width: `${summary.genderFemalePct}%` }}
              />
            )}
            {summary.genderMalePct != null && (
              <div
                className={styles.genderBarMale}
                style={{ width: `${summary.genderMalePct}%` }}
              />
            )}
          </div>
          <div className={styles.genderLegend}>
            <span>
              <span className={styles.dotFemale} /> Feminino{" "}
              {formatPct(summary.genderFemalePct)}
            </span>
            <span>
              <span className={styles.dotMale} /> Masculino{" "}
              {formatPct(summary.genderMalePct)}
            </span>
            {summary.genderOtherPct != null && summary.genderOtherPct > 0 && (
              <span>Outro {formatPct(summary.genderOtherPct)}</span>
            )}
          </div>
        </div>
      )}

      {hasCities && (
        <div className={styles.citiesBlock}>
          <p className={styles.blockLabel}>PRINCIPAIS CIDADES</p>
          <div className={styles.citiesList}>
            {summary.topCities.slice(0, 5).map((city) => (
              <div key={city.name} className={styles.cityRow}>
                <span className={styles.cityName}>{city.name}</span>
                <span className={styles.cityPct}>{city.pct.toFixed(1)}%</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {!hasGender && !hasCities && !hasGapData && (
        <p className={styles.emptyState}>
          Sem dado de audiência para este período ainda.
        </p>
      )}
    </GlassCard>
  );
}
</file>

<file path="components/content/CriticalAlert.module.css">
/* ============================================================================
   CriticalAlert.module.css — Refatoração 15/08/2026
   Todos os valores vêm de ssot-design-tokens.css (var(--token)). Nenhum
   :root local redeclarado — token duplicado era exatamente a causa da
   divergência de paleta entre este arquivo e AlertCard.module.css.
   4 classes de severidade porque AlertSeverity tem 4 valores reais
   (info|warning|critical|success) — ver orbit.ts.
   ============================================================================ */

.card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  border: var(--border-width) solid var(--line);
  border-radius: var(--r12);
  padding: var(--space-4) var(--space-5);
  width: 100%;
  background-color: var(--bg2);
  font-family: var(--font);
  transition: all var(--transition-fast);
}

.critical {
  background: linear-gradient(135deg, rgba(255, 68, 68, 0.08), transparent);
  border-color: var(--neon-red);
  box-shadow: var(--shadow-glow-red);
}

.warning {
  background: linear-gradient(135deg, rgba(255, 195, 0, 0.08), transparent);
  border-color: var(--neon-gold);
  box-shadow: var(--shadow-glow-gold);
}

.info {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.06), transparent);
  border-color: var(--neon-cyan);
  box-shadow: var(--shadow-glow-cyan);
}

.success {
  background: linear-gradient(135deg, rgba(46, 204, 113, 0.06), transparent);
  border-color: var(--green);
  /* EXTRAPOLADO: não existe --shadow-glow-green em ssot-design-tokens.css;
     valor abaixo segue o mesmo padrão (cor do estado, alpha 0.2) dos glows
     confirmados, mas não está no SSOT. */
  box-shadow: 0 0 20px rgba(46, 204, 113, 0.2);
}

.icon {
  font-size: var(--font-size-lg);
  flex-shrink: 0;
  margin-top: 1px;
}

.content {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--t0);
}

.body {
  font-size: var(--font-size-xs);
  color: var(--t1);
  line-height: var(--line-height-base);
}

.action {
  align-self: flex-start;
  margin-top: var(--space-2);
  padding: var(--space-1) var(--space-3);
  border: none;
  border-radius: var(--r4);
  background: transparent;
  color: var(--acc);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  cursor: pointer;
  text-decoration: underline;
  transition: color var(--transition-fast);
}

.action:hover {
  color: var(--acc2-text); /* FIX WCAG: --acc2 puro é 4.17:1 sobre --bg2 (falha AA) */
}

.label {
  font-weight: var(--font-weight-bold);
  color: var(--t0);
}

.actionText {
  margin-top: var(--space-1);
  font-size: var(--font-size-xs);
  color: var(--t0);
  line-height: var(--line-height-base);
}
</file>

<file path="components/content/CriticalAlert.tsx">
/**
 * ============================================================================
 * CriticalAlert — Refatoração 15/08/2026
 * ============================================================================
 *
 * VIOLAÇÕES CORRIGIDAS:
 * - Removido `const styles: any = {}` (REGRA-07 — `any` proibido sem
 *   exceções). Esse placeholder também fazia o import de CSS Module ser
 *   inócuo: nada em `styles.*` renderizava classe real nenhuma.
 * - CSS Module restaurado de verdade: `import styles from
 *   './CriticalAlert.module.css'`.
 * - Tipos importados de `src/types/orbit.ts` (fonte de verdade), não
 *   redeclarados.
 *
 * CONTRATO REAL (verificado em orbit.ts, não assumido):
 * - `CriticalAlertData.severity` é `AlertSeverity`
 *   ('info'|'warning'|'critical'|'success') — NÃO é `ClientHealthStatus`.
 *   São dois vocabulários distintos e sobrepostos parcialmente (ver
 *   OBSERVAÇÃO 13 em orbit.ts); `ClientHealthStatus` é o vocabulário
 *   canônico de "saúde de cliente" (REGRA-09), não de "severidade de
 *   alerta". Forçar `CriticalAlertData` a falar `ClientHealthStatus`
 *   seria REGRA-01 (divergir do contrato real por conveniência).
 * - `CriticalAlertData` NÃO tem campo `action: AlertAction` — tem
 *   `actionUrl?: string | null`. O prompt original assumia uma ação
 *   estruturada que não existe neste tipo; usamos o campo real.
 * - Não existe `timestamp` em `CriticalAlertData`.
 *
 * ============================================================================
 */
import React from 'react'
import type { CriticalAlertData, AlertSeverity } from '@/types/orbit'
import styles from './CriticalAlert.module.css'

export interface CriticalAlertProps {
  alert: CriticalAlertData
  className?: string
  /** Se omitido, abre `alert.actionUrl` em nova aba. */
  onActionClick?: (actionUrl: string) => void
}

const SEVERITY_ICON: Record<AlertSeverity, React.ReactNode> = {
  critical: '⚠️',
  warning: '⚠️',
  info: 'ℹ️',
  success: '✅',
} as const

// Ponte puramente de apresentação (severidade → classe CSS local). Não é
// um mapeamento para ClientHealthStatus — ver header.
const SEVERITY_CLASS: Record<AlertSeverity, string> = {
  critical: styles.critical ?? '',
  warning: styles.warning ?? '',
  info: styles.info ?? '',
  success: styles.success ?? '',
}

export function CriticalAlert({ alert, className, onActionClick }: CriticalAlertProps) {
  const handleActionClick = () => {
    if (!alert.actionUrl) return
    if (onActionClick) {
      onActionClick(alert.actionUrl)
      return
    }
    window.open(alert.actionUrl, '_blank', 'noopener,noreferrer')
  }

  return (
    <div
      className={[styles.card, SEVERITY_CLASS[alert.severity], className].filter(Boolean).join(' ')}
      role="alert"
      aria-live="polite"
    >
      <span className={styles.icon} aria-hidden="true">
        {SEVERITY_ICON[alert.severity]}
      </span>
      <div className={styles.content}>
        <p className={styles.title}>{alert.title}</p>
        <p className={styles.body}>{alert.body}</p>
        {alert.description && alert.description !== alert.body && (
          <p className={styles.body}>{alert.description}</p>
        )}
        {alert.probableCause && (
          <p className={styles.body}>
            <strong className={styles.label}>Causa provável:</strong> {alert.probableCause}
          </p>
        )}
        {alert.immediateAction && (
          <p className={styles.actionText}>
            <strong className={styles.label}>Ação:</strong> {alert.immediateAction}
          </p>
        )}
        {alert.actionUrl && (
          <button type="button" className={styles.action} onClick={handleActionClick}>
            Ver detalhes
          </button>
        )}
      </div>
    </div>
  )
}

export default CriticalAlert
</file>

