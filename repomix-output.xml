<file path="src/components/screens/CarteiraScreen.module.css">
/* ============================================================================
   CarteiraScreen — CSS Modules
   ============================================================================ */

.main {
  display: flex;
  /* ✅ FIX (aproveitamento de tela — 11/09/2026): removido `max-width: 80rem`
     + `margin: auto`. Isso centralizava um bloco fixo de 1280px e deixava
     área morta em telas largas — comparar com InstagramOverviewPage.module.css
     `.main`, que usa `flex: 1` sem teto de largura. Carteira agora ocupa
     100% do espaço que o layout pai (`(dashboard)/layout.tsx`) já reserva
     para o conteúdo, igual à Visão Geral IG. */
  width: 100%;
  /* ✅ FIX (proporção dos cards): removido min-height:100vh — o layout
     pai (src/app/(dashboard)/layout.tsx) já força 100vh na linha
     Sidebar+conteúdo. Manter aqui também empilhava dois 100vh e criava
     a sobra vazia vista no devtools. min-height:100% deixa este .main
     preencher só o espaço que o pai já reservou. */
  min-height: 100%;
  flex-direction: column;
  gap: 1.5rem;
  padding-left: 1rem;
  padding-right: 1rem;
  padding-top: 1.5rem;
  padding-bottom: 1.5rem;
  /* ✅ FIX (proporção dos cards): estabelece um container query context.
     A partir daqui, .kpiGrid e .clientsGrid reagem à largura REAL
     disponível para o conteúdo (já descontada a sidebar de 220px),
     em vez da largura da janela inteira do navegador — que é o que
     @media sempre mede, e por isso os cards ficavam largos/rasos
     depois que a sidebar entrou no layout. */
  container-type: inline-size;
  container-name: carteira;
}

@container carteira (min-width: 640px) {
  .main {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

/* ─── Header Row ─────────────────────────────────────────────────────── */

.headRow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

/* ─── Tabs ───────────────────────────────────────────────────────────── */

.tabsContainer {
  border-radius: 1rem;
  border: 1px solid var(--line);
  background-color: var(--bg2);
  padding: 0.5rem;
}

.tabsList {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tab {
  display: inline-flex;
  align-items: center;
  border-radius: 9999px;
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  font-size: 0.75rem;
  font-weight: 500;
  transition: all 200ms;
  border: none;
  cursor: pointer;
}

.tabActive {
  background-color: var(--bg3);
  color: var(--t0);
  box-shadow: inset 0 0 0 1px var(--line);
}

.tabInactive {
  background-color: transparent;
  color: var(--t1);
}

.tabInactive:hover {
  background-color: var(--bg3);
  color: var(--t0);
}

/* ─── KPI Grid ───────────────────────────────────────────────────────── */

.kpiGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}

/* ✅ FIX: @media → @container (ver nota em .main) */
@container carteira (min-width: 640px) {
  .kpiGrid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.kpiCard {
  border-radius: 1rem;
  border: 1px solid var(--line);
  background-color: var(--bg2);
  padding: 1rem;
  transition: border-color var(--transition-base, 150ms), box-shadow var(--transition-base, 150ms);
}

/* ✅ FIX (SSOT — 11/09/2026): os 3 KPIs eram visualmente idênticos, sem
   nenhum destaque de severidade — mesmos tokens de glow que GlassCard.tsx
   já usa em glowCyan/glowGold/glowRed (Visão Geral IG), aplicados aqui via
   classe própria porque este card não passa por <GlassCard>. */
.kpiCardNeutral {
  border-color: var(--border-glow-cyan);
  box-shadow: var(--shadow-inner-cyan);
}

.kpiCardWarning {
  border-color: var(--border-glow-gold);
  box-shadow: var(--shadow-inner-gold);
}

.kpiCardCritical {
  border-color: var(--border-glow-red);
  box-shadow: var(--shadow-inner-red);
}

.kpiLabel {
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--t1);
}

.kpiValue {
  margin-top: 0.5rem;
  font-family: var(--mono);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--t0);
}

.kpiValueWarning {
  color: var(--amber);
}

.kpiValueError {
  color: var(--red);
}

/* ─── Skeleton ───────────────────────────────────────────────────────── */

.cardSkeleton {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  border-radius: 1rem;
  background-color: rgba(24, 24, 31, 0.5);
  padding: 1rem;
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.skeletonHeader {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.skeletonAvatar {
  height: 2.5rem;
  width: 2.5rem;
  border-radius: 9999px;
  background-color: var(--bg4);
}

.skeletonInfo {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 0.375rem;
}

.skeletonLine {
  height: 0.75rem;
  width: 8rem;
  border-radius: 0.25rem;
  background-color: var(--bg4);
}

.skeletonLineSmall {
  height: 0.625rem;
  width: 5rem;
  border-radius: 0.25rem;
  background-color: var(--bg4);
}

.skeletonDot {
  height: 0.625rem;
  width: 0.625rem;
  border-radius: 9999px;
  background-color: var(--bg4);
}

.skeletonDivider {
  height: 1px;
  width: 100%;
  background-color: var(--line);
}

.skeletonGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.5rem;
}

.skeletonItem {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.skeletonLabel {
  height: 0.5rem;
  width: 3rem;
  border-radius: 0.25rem;
  background-color: var(--bg4);
}

.skeletonValue {
  height: 0.875rem;
  width: 4rem;
  border-radius: 0.25rem;
  background-color: var(--bg4);
}

.skeletonsGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

/* ✅ FIX: @media → @container (ver nota em .main) */
@container carteira (min-width: 640px) {
  .skeletonsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@container carteira (min-width: 1024px) {
  .skeletonsGrid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@container carteira (min-width: 1280px) {
  .skeletonsGrid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

/* ─── Error State ────────────────────────────────────────────────────── */

.errorState {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  border-radius: 1rem;
  background-color: rgba(255, 68, 68, 0.1);
  border: 1px solid rgba(255, 68, 68, 0.2);
  padding: 2rem;
  text-align: center;
}

.errorMessage {
  font-size: 0.875rem;
  color: var(--red);
}

.retryButton {
  border-radius: 9999px;
  background-color: rgba(255, 68, 68, 0.2);
  padding-left: 1rem;
  padding-right: 1rem;
  padding-top: 0.375rem;
  padding-bottom: 0.375rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--red);
  transition: background-color 200ms;
  border: 1px solid rgba(255, 68, 68, 0.4);
  cursor: pointer;
}

.retryButton:hover {
  background-color: rgba(255, 68, 68, 0.3);
}

/* ─── Empty State ────────────────────────────────────────────────────── */

.emptyState {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 1rem;
  border: 1px solid var(--line);
  background-color: rgba(24, 24, 31, 0.2);
  padding-top: 3rem;
  padding-bottom: 3rem;
}

.emptyMessage {
  font-size: 0.875rem;
  color: var(--text-muted);
}

/* ─── Clients Grid ───────────────────────────────────────────────────── */

.clientsGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

/* ✅ FIX principal: @media → @container. Antes, este grid contava colunas
   com base na largura da JANELA (ignorando os 220px da sidebar); agora
   conta com base na largura real disponível para o .main (container
   "carteira" definido acima) — os cards voltam a ter o tamanho/proporção
   desenhados independente da largura da sidebar. */
@container carteira (min-width: 640px) {
  .clientsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@container carteira (min-width: 1024px) {
  .clientsGrid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@container carteira (min-width: 1280px) {
  .clientsGrid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.clientWrapper {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.alertsContainer {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-left: 0.25rem;
}

/* ─── Global Alerts Section ──────────────────────────────────────────── */

.globalAlertsSection {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border-top: 1px solid var(--line);
  padding-top: 1.25rem;
