{
  "type": "module",
  "name": "orbit-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "check:drift": "ts-node src/types/check-schema-drift.ts",
    "test": "tsx --test src/lib/funnel/registry.test.ts src/lib/repositories/funnelMath.test.ts src/lib/mappers/avatarAlignment/avatarAlignment.mapper.test.ts",
    "test:bloco-a": "vitest run e2e/blocoA.e2e.test.ts",
    "prepare": "husky",
    "ingest:zip": "tsx scripts/ingest/ingest-from-zip.ts",
    "ingest:csv": "tsx scripts/ingest/ingest-meta-csv.ts",
    "ingest:reels": "tsx scripts/ingest/ingest-apify-reel-views.ts",
    "ingest:comments": "tsx scripts/ingest/ingest-apify-comments.ts",
    "audit:ingest": "tsx scripts/audit/check-ingestion.ts",
    "audit:clients": "tsx scripts/audit/audit-5-clients.ts",
    "audit:ogp": "tsx scripts/audit/ogp-audit.ts",
    "audit:copy": "node scripts/copy/copy-audit.mjs",
    "kcr:reconcile": "tsx scripts/contracts/reconcile-kpi-contracts.ts",
    "db:seed": "tsx scripts/db/seed-dynamic.ts",
    "db:cleanup": "node scripts/db/cleanup-example-seed.mjs",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.116.0",
    "@types/adm-zip": "^0.5.8",
    "@types/react-router-dom": "^5.3.3",
    "adm-zip": "^0.6.1",
    "choco": "^0.2.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.52.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.0",
    "ts-morph": "^28.0.0",
    "web-vitals": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@supabase/cli": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pgtyped": "^0.0.1",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "ts-node": {
    "esm": true,
    "experimentalEsm": true
  }
}
