}

/* ─── Clients Grid ───────────────────────────────────────────────────── */

.clientsGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

/* ✅ FIX principal: @media → @container. Antes, este grid contava colunas
   com base na largura da JANELA (ignorando os 220px da sidebar); agora
   conta com base na largura real disponível para o .main (container
   "carteira" definido acima) — os cards voltam a ter o tamanho/proporção
   desenhados independente da largura da sidebar. */
@container carteira (min-width: 640px) {
  .clientsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
