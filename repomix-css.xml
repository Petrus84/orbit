<file path="src/components/common/AlertCard.module.css">
/* ============================================================================
   AlertCard.module.css
   Reconstruído 14/08/2026 no padrão real do projeto (CSS Modules por
   componente), confirmado contra CriticalAlert.module.css — substitui a
   entrega anterior (alerts.css global, classes .alert/.alert-crit, tokens
   extraídos do protótipo HTML). Esse padrão anterior não é o que o projeto
   usa de verdade; REGRA-07/convenção real pede CSS Module por componente.

   TOKENS CONFIRMADOS (vistos literalmente em CriticalAlert.module.css):
     --space-1, --space-3, --space-4, --space-5
     --border-width, --border-default, --border-radius-lg
     --border-glow-red, --border-glow-gold, --border-glow-cyan
     --text-primary, --text-muted
     --font-size-lg, --font-size-sm, --font-size-xs
     --font-weight-bold

   TOKENS NÃO CONFIRMADOS (usados abaixo por necessidade — AlertCard tem
   mais elementos que CriticalAlert: métrica comparativa, botões, status).
   Marcados inline com ⚠️. Não vi nenhum arquivo que confirme o nome real
   destes — se o token real tiver outro nome, é achar-e-substituir, não
   reescrever a estrutura.
   FIX 09/09/2026 — rgba(255, 65, 54, ...) corrigido pra rgba(255, 68, 68, ...)
   em 4 ocorrências (.critical, .severityBadge.critical, .critical .btn).
   O valor antigo era um vermelho ligeiramente diferente do --red/--neon-red
   oficial (#FF4444 = rgb(255,68,68)) — drift confirmado contra o protótipo
   SSOT, provavelmente cópia manual desatualizada. Demais cores (gold, cyan,
   green) já batiam exatamente com os tokens, não precisaram de correção.
   ============================================================================ */

.card {
  position: relative;
  display: flex;
  gap: var(--space-4);
  border: var(--border-width) solid var(--border-default);
  border-radius: var(--border-radius-lg);
  padding: var(--space-4) var(--space-5);
  width: 100%;
}

.critical {
  background: linear-gradient(135deg, rgba(255, 68, 68, 0.08), rgba(255, 68, 68, 0.03));
  border-color: var(--border-glow-red);
  box-shadow: 0 0 24px rgba(255, 68, 68, 0.1);
}

.warning {
  background: linear-gradient(135deg, rgba(255, 195, 0, 0.08), rgba(255, 195, 0, 0.03));
  border-color: var(--border-glow-gold);
  box-shadow: 0 0 24px rgba(255, 195, 0, 0.1);
}

.info {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.06), rgba(0, 255, 255, 0.02));
  border-color: var(--border-glow-cyan);
  box-shadow: 0 0 24px rgba(0, 255, 255, 0.08);
}

/* ✅ ADICIONADO 07/09 — AlertSeverity inclui 'success' (orbit.ts), mas o
   módulo só cobria critical/warning/info. Usa --green (SSOT), não uma
   nova cor fora da paleta. */
.success {
  background: linear-gradient(135deg, rgba(46, 204, 113, 0.08), rgba(46, 204, 113, 0.03));
  border-color: var(--green);
  box-shadow: 0 0 24px rgba(46, 204, 113, 0.1);
}
.success .btn {
  background: rgba(46, 204, 113, 0.12);
  border-color: var(--green);
  color: var(--text-primary);
}

.icon {
  font-size: var(--font-size-lg);
  flex-shrink: 0;
  margin-top: 1px;
}

.body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

/* ✅ ADICIONADO 07/09 — linha título + timestamp (padrão .row-between do
   protótipo, aplicado como CSS Module em vez de classe global). */
.headerRow {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
}

/* ✅ ADICIONADO 08/09 — agrupa título + badge de severidade no cabeçalho,
   paridade com `row-between mb8` (alert-title + badge-red/amber) do
   protótipo. */
.titleGroup {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  min-width: 0;
}

/* Badge pequeno — cores próprias, não reaproveita o gradiente/glow de
   .critical/.warning/.info/.success (feitos para o card inteiro; um glow
   de 24px numa pill de texto pequena borra o contorno). */
.severityBadge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: 1px var(--space-3);
  border-radius: var(--radius-lg);
  border: var(--border-width) solid;
  background: none;
  box-shadow: none;
}

.severityBadge.critical {
  color: var(--red-text); /* FIX (19/09/2026): hex cru #ff8080 voltou numa edição posterior — reaplicado o token */
  border-color: var(--border-glow-red);
  background: rgba(255, 68, 68, 0.15);
}
.severityBadge.warning {
  color: var(--amber);
  border-color: var(--border-glow-gold);
  background: rgba(255, 195, 0, 0.12);
}
.severityBadge.info {
  color: var(--blue-text); /* FIX (19/09/2026): hex cru #7eb3ff voltou numa edição posterior — reaplicado o token */
  border-color: var(--border-glow-cyan);
  background: rgba(0, 255, 255, 0.1);
}
.severityBadge.success {
  color: var(--green);
  border-color: var(--green);
  background: rgba(46, 204, 113, 0.12);
}

.timestamp {
  flex-shrink: 0;
  font-family: var(--mono);
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  white-space: nowrap;
}

.title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.text {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  line-height: 1.5;
}

/* ✅ ADICIONADO (P0 — v8.2): fileira de chips de contexto (métrica,
   natureza, confiança). Mesma lógica visual do .severityBadge (pill
   pequena, sem o glow de 24px do card inteiro), mas neutra — não é um
   indicador de severidade, é metadado de proveniência do alerta. */
.chipRow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-top: var(--space-1);
}

.chip {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: 1px var(--space-3);
  border-radius: var(--border-radius-lg);
  border: var(--border-width) solid var(--border-default);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-muted);
  white-space: nowrap;
}

/* natureza: 'tecnica' | 'comunicacao' — mesma paleta cyan do .info, mas
   sem glow (é rótulo de metadado, não status de alerta). */
.chipNatureza {
  border-color: var(--border-glow-cyan);
  color: var(--blue-text); /* FIX (19/09/2026): novo desde a última rodada — nasceu com hex cru #7eb3ff em vez do token, mesmo drift dos outros dois badges */
  background: rgba(0, 255, 255, 0.06);
}

/* confidence_level: L0/L1/L2 — FIX (19/09/2026): as cores estavam na
   direção errada (L2 verde/melhor, L0 neutro/pior). Confirmado contra
   contentContractEngine.ts (15+ usos: L0 = dado real/direto, L2 = fallback
   sem breakdown ou amostra insuficiente) e contra KPICard.tsx (L0 sempre
   foi verde ali). L0 = Medido (melhor) → verde. L1 = Estimado → âmbar.
   L2 = Hipótese (pior) → neutro, sem alarmar como se fosse erro. */
.chipConfidenceL0 {
  border-color: var(--green);
  color: var(--green);
  background: rgba(46, 204, 113, 0.1);
}
.chipConfidenceL1 {
  border-color: var(--border-glow-gold);
  color: var(--amber);
  background: rgba(255, 195, 0, 0.1);
}
.chipConfidenceL2 {
  border-color: var(--border-default);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.04);
}

/* ⚠️ --space-2 não confirmado — usei --space-1 (confirmado) como aproximação
   conservadora até alguém confirmar se --space-2 existe de verdade. */
.meta {
  margin-top: var(--space-3);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--border-radius-lg);
  background: rgba(0, 0, 0, 0.25);
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  display: flex;
  justify-content: space-between;
}

.action {
  margin-top: var(--space-3);
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  align-items: center;
}

/* ⚠️ --font-weight-medium e --border-radius-md/full não confirmados.
   Usei --font-weight-bold (confirmado) e --border-radius-lg (confirmado)
   até ter o arquivo real de botão pra conferir. */
.btn {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: var(--space-1) var(--space-4);
  border-radius: var(--border-radius-lg);
  cursor: pointer;
  border: var(--border-width) solid;
  background: none;
  text-decoration: none;
  transition: opacity 120ms ease;
}
.btn:hover { opacity: 0.85; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.critical .btn {
  background: rgba(255, 68, 68, 0.15);
  border-color: var(--border-glow-red);
  color: var(--text-primary);
}
.warning .btn {
  background: rgba(255, 195, 0, 0.12);
  border-color: var(--border-glow-gold);
  color: var(--text-primary);
}
.info .btn {
  background: rgba(0, 255, 255, 0.12);
  border-color: var(--border-glow-cyan);
  color: var(--text-primary);
}

.btnGhost {
  background: none !important;
  border-color: var(--border-default) !important;
  color: var(--text-muted) !important;
}

.status {
  margin-top: var(--space-3);
  font-size: var(--font-size-xs);
  color: var(--text-muted);
}

.dismiss {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: var(--space-1);
}
.dismiss:hover { color: var(--text-primary); }
</file>

<file path="src/styles/ssot-design-tokens.css">
/* ==========================================================================
   ORBIT · Design Tokens (SSOT Prototype — 100% Aligned)
   Versão: 2.1.0  |  Data: 2026-09-09

   CORRIGIDO para bater com os valores reais do protótipo
   (orbit-prototipo-consolidado-neon.html :root), verificado token a token.
   Mudanças vs. 2.0.0: spacing, font-size, radius, transitions, font-weight,
   line-height. Nomes/aliases existentes mantidos para não quebrar os
   ~25 arquivos .module.css que já consomem estes tokens.
   ========================================================================== */

:root {
  /* ═══════════════════════════════════════════════════════════════
     BACKGROUNDS (SSOT — 5 camadas neomorphic) — sem alteração
     ═══════════════════════════════════════════════════════════════ */

  --bg: #0C0C0F;
  --bg1: #111116;
  --bg2: #18181F;
  --bg3: #1F1F28;
  --bg4: #26262F;

  --bg-base: var(--bg);
  --bg-primary: var(--bg1);
  --bg-card: var(--bg2);
  --bg-hover: var(--bg3);
  --bg-active: var(--bg4);

  /* ═══════════════════════════════════════════════════════════════
     BORDERS (SSOT) — sem alteração
     ═══════════════════════════════════════════════════════════════ */

  --line: #2A2A35;
  --line2: #33333F;

  --border-default: var(--line);
  --border-glow-cyan: #00FFFF;
  --border-glow-red: #FF4444;
  --border-glow-gold: #FFC300;
  --border-glow-green: #2ECC71;
  --border-width: 1px;

  /* ═══════════════════════════════════════════════════════════════
     TEXT (SSOT — Hierarchy com warmth) — sem alteração
     ═══════════════════════════════════════════════════════════════ */

  --t0: #F0EFE8;
  --t1: #B8B6B0;
  --t2: #706E6A;
  --t3: #454340;

  --text-primary: var(--t0);
  --text-secondary: var(--t1);
  /* FIX WCAG 1.4.3 mantido: --t2/--t3 falham AA, redirecionado pra --t1 */
  --text-muted: var(--t1);
  --text-dim: var(--t1);

  /* ═══════════════════════════════════════════════════════════════
     ACCENTS & NEONS (SSOT — Unique identity) — sem alteração
     ═══════════════════════════════════════════════════════════════ */

  --acc: #C8FF57;
  --acc2: #8B5CF6;
  --acc3: #FF6B35;

  /* FIX WCAG 1.4.3 (15/09/2026): --acc2 usado como cor de TEXTO falha AA
     (4.17:1 sobre --bg2, 3.86:1 sobre --bg3). --acc2 continua válido para
     bordas/fundos/ícones, que só precisam de 3:1. Para texto, usar
     --acc2-text (mesmo roxo, 20% mais claro — 5.7:1+ em qualquer fundo). */
  --acc2-text: #a27df8;

  --red: #FF4444;
  --amber: #FFB020;
  --green: #2ECC71;
  --blue: #4A90FF;

  /* Variantes claras p/ texto sobre badge já tingido (ex.: rgba(--red, 0.15)
     de fundo) — mantém legibilidade sem introduzir tom fora do sistema.
     Consolida os hex que existiam soltos (#ff8080, #7eb3ff) em tokens nomeados. */
  --red-text: #ff8080;
  --blue-text: #7eb3ff;

  --neon-cyan: #00FFFF;
  --neon-red: #FF4444;
  --neon-gold: #FFC300;
  --neon-green: var(--green); /* alias legado — #00FF00 não existe no protótipo (nota da v2.0.0); mapeado pro verde oficial em 09/09/2026 */

  /* ═══════════════════════════════════════════════════════════════
     TYPOGRAPHY (SSOT — DM Sans + DM Mono)
     CORRIGIDO: escala inteira estava maior que o protótipo
     ═══════════════════════════════════════════════════════════════ */

  --font: 'DM Sans', sans-serif;
  --mono: 'DM Mono', monospace;

  --font-family: var(--font);
  --font-mono: var(--mono);

  /* pesos — adicionados light/medium que faltavam */
  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: var(--font-weight-semibold); /* alias mantido p/ compatibilidade */

  /* line-heights — adicionados tight/relaxed que faltavam */
  --line-height-tight: 1.2;
  --line-height-base: 1.5;
  --line-height-relaxed: 1.6;

  /* Font sizes — corrigido pra bater exatamente com o protótipo */
  --font-size-xs: 10px;
  --font-size-sm: 11px;
  --font-size-base: 12px;
  --font-size-md: 13px;
  --font-size-lg: 15px;
  --font-size-xl: 15px;
  --font-size-2xl: 16px;
  --font-size-3xl: 22px;
  --font-size-4xl: 26px;

  /* ═══════════════════════════════════════════════════════════════
     BORDER RADIUS (SSOT)
     CORRIGIDO: md/lg estavam deslocados em relação ao protótipo
     ═══════════════════════════════════════════════════════════════ */

  --r3: 3px;
  --r4: 4px;
  --r6: 6px;
  --r8: 8px;
  --r12: 12px;
  --r16: 16px;
  --r24: 24px;

  --border-radius-sm: var(--r4);
  --border-radius-md: var(--r6);
  --border-radius-lg: var(--r8);
  --radius-xs: var(--r3);
  --radius-sm: var(--r4);
  --radius-md: var(--r6);
  --radius-lg: var(--r8);
  --radius-xl: var(--r12);
  --radius-2xl: var(--r16);
  --radius-3xl: var(--r24);
  --radius-pill: 9999px;

  /* ═══════════════════════════════════════════════════════════════
     SHADOWS — sem alteração
     ═══════════════════════════════════════════════════════════════ */

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.5);
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.5);

  --shadow-glow-cyan: 0 0 20px rgba(0, 255, 255, 0.3);
  --shadow-glow-red: 0 0 20px rgba(255, 68, 68, 0.3);
  --shadow-glow-gold: 0 0 20px rgba(255, 195, 0, 0.3);
  --shadow-glow-green: 0 0 20px rgba(46, 204, 113, 0.3);

  --shadow-outer-sm: var(--shadow-sm);
  --shadow-outer-md: var(--shadow-md);
  --shadow-outer-lg: var(--shadow-lg);
  --shadow-inner-cyan: var(--shadow-glow-cyan);
  --shadow-inner-red: var(--shadow-glow-red);
  --shadow-inner-gold: var(--shadow-glow-gold);
  --shadow-inner-green: var(--shadow-glow-green);

  /* ═══════════════════════════════════════════════════════════════
     TRANSITIONS
     CORRIGIDO: durações e easing estavam diferentes do protótipo
     ═══════════════════════════════════════════════════════════════ */

  --transition-fast: 120ms ease;
  --transition-base: 200ms ease;
  --transition-slow: 300ms ease;

  /* ═══════════════════════════════════════════════════════════════
     SPACING (SSOT)
     CORRIGIDO: escala inteira estava maior que o protótipo,
     e faltavam space-7 e space-9
     ═══════════════════════════════════════════════════════════════ */

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 8px;
  --space-4: 12px;
  --space-5: 16px;
  --space-6: 16px;
  --space-7: 20px;
  --space-8: 24px;
  --space-9: 32px;
  --space-10: 48px;
  --space-12: var(--space-10); /* alias mantido p/ compatibilidade com código existente */

  /* ═══════════════════════════════════════════════════════════════
     LAYOUT (SSOT — dimensões fixas) — sem alteração
     ═══════════════════════════════════════════════════════════════ */

  --sidebar-width: 220px;
  --header-height: 52px;

  /* ── Tokens derivados (usados por QualityScoresPanel.module.css) ── */
  --color-cyan-rgb: 0, 255, 255;
  --color-red-rgb: 255, 68, 68;
  --color-gold-rgb: 255, 195, 0;
  --color-green-rgb: 46, 204, 113;

  --opacity-30: 0.3;
  --opacity-50: 0.5;

  --shadow-glow-cyan-30: 0 0 24px rgba(var(--color-cyan-rgb), 0.3);

  --shadow-glow-cyan-inset: inset 0 0 12px rgba(var(--color-cyan-rgb), 0.08);
  --shadow-glow-cyan-inset-hover: inset 0 0 16px rgba(var(--color-cyan-rgb), 0.16);
  --shadow-glow-red-inset: inset 0 0 12px rgba(var(--color-red-rgb), 0.08);
  --shadow-glow-red-inset-hover: inset 0 0 16px rgba(var(--color-red-rgb), 0.16);
  --shadow-glow-gold-inset: inset 0 0 12px rgba(var(--color-gold-rgb), 0.08);
  --shadow-glow-gold-inset-hover: inset 0 0 16px rgba(var(--color-gold-rgb), 0.16);
  --shadow-glow-green-inset: inset 0 0 12px rgba(var(--color-green-rgb), 0.08);
  --shadow-glow-green-inset-hover: inset 0 0 16px rgba(var(--color-green-rgb), 0.16);

  --gradient-cyan-subtle: linear-gradient(180deg, rgba(var(--color-cyan-rgb), 0.04), transparent);
  --gradient-cyan-hover: linear-gradient(180deg, rgba(var(--color-cyan-rgb), 0.08), transparent);
  --gradient-gray-hover: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent);
}
