/* ==========================================================================
   ORBIT · Component — QualityScoresPanel.module.css
   Grade 2×2: Score Utilidade · Score Polêmica · VFE · ER Real
   Versão: 1.0.3  |  Data: 2026-10-05

   MUDANÇA v1.0.3 (SSOT Compliance):
   - Removidos TODOS os valores hardcoded rgba/gradientes
   - Substituídos por tokens: --opacity-*, --color-*-rgb, --gradient-*, --shadow-*
   - Resultado: 100% SSOT compliance, zero hardcoding
   ========================================================================== */

/* ═══════════════════════════════════════════════════════════════
   PAINEL PRINCIPAL
   ═══════════════════════════════════════════════════════════════ */

.panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-4);
  background-color: var(--bg2);
  border: 1px solid var(--line);
  border-radius: var(--r12);
  box-shadow: var(--shadow-glow-cyan);
  transition: all var(--transition-base);
}

.panel:hover {
  border-color: var(--border-glow-cyan);
  box-shadow: var(--shadow-glow-cyan-30);  /* ✅ Token em vez de hardcoded */
}

/* ═══════════════════════════════════════════════════════════════
   TÍTULO DO PAINEL
   ═══════════════════════════════════════════════════════════════ */

.panelTitle {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--neon-cyan);
  text-transform: uppercase;
  margin: 0;
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--line);
}

/* ═══════════════════════════════════════════════════════════════
   GRID 2×2
   ═══════════════════════════════════════════════════════════════ */

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

@media (max-width: 768px) {
  .grid {
    grid-template-columns: 1fr;
  }
}

/* ═══════════════════════════════════════════════════════════════
   SCORE BOX — BASE
   ═══════════════════════════════════════════════════════════════ */

.scoreBox {
  padding: var(--space-3) var(--space-4);
  background: var(--gradient-cyan-subtle);  /* ✅ Token em vez de hardcoded */
  border: 1px solid var(--line);
  border-radius: var(--r8);
  transition: 
    transform var(--transition-fast),
    box-shadow var(--transition-fast),
    border-color var(--transition-fast),
    background var(--transition-fast);
  cursor: default;
}
.grid > .scoreBox:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.scoreBox:hover {
  background: var(--gradient-cyan-hover);  /* ✅ Token em vez de hardcoded */
  transform: translateY(-2px);
}

/* ═══════════════════════════════════════════════════════════════
   SCORE BOX — VARIANTES DE COR (Glow)
   ═══════════════════════════════════════════════════════════════ */

.boxCyan {
  border-color: rgba(var(--color-cyan-rgb), var(--opacity-30));  /* ✅ RGB + opacity tokens */
  box-shadow: var(--shadow-glow-cyan-inset);  /* ✅ Token */
}

.boxCyan:hover {
  border-color: rgba(var(--color-cyan-rgb), var(--opacity-50));  /* ✅ RGB + opacity tokens */
  box-shadow: var(--shadow-glow-cyan-inset-hover);  /* ✅ Token */
}

.boxRed {
  border-color: rgba(var(--color-red-rgb), var(--opacity-30));  /* ✅ RGB + opacity tokens */
  box-shadow: var(--shadow-glow-red-inset);  /* ✅ Token */
}

.boxRed:hover {
  border-color: rgba(var(--color-red-rgb), var(--opacity-50));  /* ✅ RGB + opacity tokens */
  box-shadow: var(--shadow-glow-red-inset-hover);  /* ✅ Token */
}

.boxGold {
  border-color: rgba(var(--color-gold-rgb), var(--opacity-30));  /* ✅ RGB + opacity tokens */
  box-shadow: var(--shadow-glow-gold-inset);  /* ✅ Token */
}

.boxGold:hover {
  border-color: rgba(var(--color-gold-rgb), var(--opacity-50));  /* ✅ RGB + opacity tokens */
  box-shadow: var(--shadow-glow-gold-inset-hover);  /* ✅ Token */
}

.boxNeutral {
  border-color: var(--line);
  box-shadow: none;
}

.boxNeutral:hover {
  border-color: var(--line2);
  background: var(--gradient-gray-hover);  /* ✅ Token em vez de hardcoded */
}

.boxGreen {
  border-color: rgba(var(--color-green-rgb), var(--opacity-30));
  box-shadow: var(--shadow-glow-green-inset);
}

.boxGreen:hover {
  border-color: rgba(var(--color-green-rgb), var(--opacity-50));
  box-shadow: var(--shadow-glow-green-inset-hover);
}

.statusSuccess {
  color: var(--green);
}

/* ═══════════════════════════════════════════════════════════════
   CONTEÚDO INTERNO DO SCORE BOX
   ═══════════════════════════════════════════════════════════════ */

.scoreLabel {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);  /* ✅ Token em vez de hardcoded 500 */
  letter-spacing: 0.03em;
  color: var(--text-muted);
  text-transform: uppercase;
  margin: 0 0 var(--space-2) 0;
}

.scoreValue {
  margin: 0 0 var(--space-2) 0;
  line-height: 1;
  min-height: 40px;
  display: flex;
  align-items: center;
}

.naValue {
  font-family: var(--mono);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);  /* ✅ Token em vez de hardcoded 700 */
  color: var(--t1);
  line-height: 1;
}

/* ═══════════════════════════════════════════════════════════════
   STATUS TEXT
   ═══════════════════════════════════════════════════════════════ */

.statusText {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);  /* ✅ Token */
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin: 0;
  line-height: var(--line-height-base);  /* ✅ Token em vez de hardcoded 1.4 */
}

.statusOk {
  color: var(--green);
}

.statusWarn {
  color: var(--amber);
}

.statusDanger {
  color: var(--red-text);
}

.statusNeutral {
  color: var(--text-muted);
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVIDADE E ACESSIBILIDADE
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .panel,
  .scoreBox {
    transition: none;
  }

  .scoreBox:hover {
    transform: none;
  }
}

.panel:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 2px;
}

.scoreBox:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 1px;
}

.actionText {
  margin-top: var(--space-1);  /* ✅ Removido fallback manual */
  font-size: var(--font-size-xs);
  line-height: var(--line-height-base);  /* ✅ Token */
  color: var(--text-primary);
}

.referenceNote {
  margin-top: var(--space-1);  /* ✅ Removido fallback manual */
  font-size: var(--font-size-xs);
  line-height: var(--line-height-base);  /* ✅ Token */
  font-style: italic;
  color: var(--text-muted);
}
