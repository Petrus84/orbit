/* ClientCard.module.css */

.card {
  position: relative;
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: var(--space-4);
  border: var(--border-width) solid var(--line);
  border-radius: var(--r16);
  background: linear-gradient(180deg, var(--bg2) 0%, rgba(12, 12, 15, 0.94) 100%);
  padding: var(--space-4);
  text-align: left;
  transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  cursor: pointer;
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

/* ✅ ADICIONADO 08/09 — filete de topo por severidade (paridade com
   .client-card::before / .cc-cyan/.cc-gold/.cc-red do protótipo). */
.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
}

.accentHealthy::before { background: var(--neon-cyan); }
.accentWarning::before { background: var(--neon-gold); }
.accentCritical::before { background: var(--neon-red); }
.accentUnknown::before { background: var(--line2); }

.card:hover {
  transform: translateY(-2px);
  border-color: var(--line2);
  background: var(--bg3);
}

.card:focus-visible {
  outline: 2px solid var(--acc);
  outline-offset: 2px;
}

.header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.avatarImage {
  height: 40px;
  width: 40px;
  border-radius: var(--radius-pill);
  object-fit: cover;
}

.avatarFallback {
  display: flex;
  height: 40px;
  width: 40px;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background-color: var(--bg4);
  font-family: var(--font);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--t1);
}

.identity {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2px;
}

.name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--t0);
}

.handle {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font);
  font-size: var(--font-size-xs);
  color: var(--t1);
}

.divider {
  height: 1px;
  width: 100%;
  background-color: var(--line);
}

.statusBadge {
  display: inline-flex;
  align-items: center;
  padding: 2px var(--space-2);
  border-radius: var(--radius-pill);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
}

/* FIX 09/09/2026 — cores eram Tailwind (emerald/amber/rose), fora da
   paleta Orbit. Corrigido pra paleta neon única (healthy=cyan, não verde
   — ver decisão de 22/07/2026 documentada no protótipo SSOT, mesmo
   vocabulário do .accentHealthy/.accentWarning/.accentCritical acima). */
.statusHealthy {
  background-color: rgba(0, 255, 255, 0.1);
  color: var(--neon-cyan);
}

.statusWarning {
  background-color: rgba(255, 195, 0, 0.1);
  color: var(--neon-gold);
}

.statusCritical {
  background-color: rgba(255, 68, 68, 0.1);
  color: var(--neon-red);
