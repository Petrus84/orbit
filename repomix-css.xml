<file path="src/components/layout/Sidebar.module.css">
/* Sidebar.module.css */

.sidebar {
  width:          var(--sidebar-width);
  min-width:      var(--sidebar-width);
  flex-shrink:    0; /* FIX a11y (15/09/2026): sem isso, um flex container
    apertado deixa o navegador encolher a sidebar por baixo de 220px,
    quebrando .navItem/.navLabel de forma imprevisível por tela. */
  background:     var(--bg-card);
  border-right:   var(--border-width) solid var(--border-default);
  padding:        var(--space-5) var(--space-4);
  display:        flex;
  flex-direction: column;
  gap:            var(--space-1);
  overflow-y:     auto;
  height:         100%;
}

/* DECISÃO DE ESCOPO (15/09/2026): a sidebar não tem um padrão de colapso
   (ícone-only + toggle) porque isso é uma funcionalidade nova — precisa de
   estado, affordance de abrir/fechar e provavelmente tooltip nos ícones, e
   inventar isso sem especificação arrisca esconder o texto do link do jeito
   errado (display:none no .navLabel apagaria o nome acessível do link, já
   que o ícone tem aria-hidden). Rede de segurança até essa decisão de
   produto: abaixo de 900px o shell inteiro rola na horizontal em vez de
   esmagar a sidebar ou o conteúdo — ver `(dashboard)/layout.tsx`. */

/* Logo */

.logo {
  display:       flex;
  align-items:   center;
  gap:           var(--space-2);
  padding-bottom: var(--space-5);
  border-bottom: var(--border-width) solid var(--border-default);
  margin-bottom: var(--space-2);
}

.logoBadge {
  width:           28px;
  height:          28px;
  border-radius:   var(--border-radius-md);
  background:      rgba(0, 255, 255, 0.1);
  border:          var(--border-width) solid rgba(0, 255, 255, 0.3);
  display:         flex;
  align-items:     center;
  justify-content: center;
  font-size:       11px;
  font-weight:     var(--font-weight-bold);
  color:           var(--neon-cyan);
  text-shadow:     0 0 8px var(--neon-cyan);
  flex-shrink:     0;
}

.logoName {
  font-size:      13px;
  font-weight:    var(--font-weight-bold);
  color:          var(--text-primary);
  letter-spacing: 2px;
}

.logoSub {
  font-size: var(--font-size-xs);
  color:          var(--text-dim);
  letter-spacing: 2px;
  margin-top:     1px;
}

/* Cliente ativo */

.clientBox {
  background:    var(--bg-hover);
  border:        var(--border-width) solid var(--border-default);
  border-radius: var(--border-radius-md);
  padding:       var(--space-3);
  margin-bottom: var(--space-4);
}

.clientLabel {
  font-size: var(--font-size-xs);
  color:          var(--text-dim);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom:  var(--space-1);
}

.clientName {
  display:     flex;
  align-items: center;
  gap:         var(--space-2);
  font-size:   var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color:       var(--text-primary);
}

.clientDot {
  width:         6px;
  height:        6px;
  border-radius: 50%;
  background:    var(--neon-green);
  box-shadow:    0 0 6px var(--neon-green);
  margin-left:   auto;
}

/* Seção label */

.sectionLabel {
  font-size: var(--font-size-xs);
  color:          var(--text-dim);
  letter-spacing: 2px;
  text-transform: uppercase;
  padding:        var(--space-4) var(--space-2) var(--space-2);
}

/* Nav */

.navList {
  list-style:     none;
  display:        flex;
  flex-direction: column;
  gap:            2px;
}

.navItem {
  display:       flex;
  align-items:   center;
  gap:           var(--space-2);
  padding:       var(--space-2) var(--space-3);
  border-radius: var(--border-radius-md);
  font-size:     var(--font-size-sm);
  color:         var(--text-muted);
  text-decoration: none;
  transition:    background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  border-left:   2px solid transparent;
}

.navItem:hover {
  background: var(--bg-hover);
  color:      var(--text-primary);
}

.navItemActive {
  background:   var(--bg-hover);
  color:        var(--text-primary);
  border-left:  2px solid var(--neon-cyan);
}

.navIcon {
  font-size:   var(--font-size-base);
  flex-shrink: 0;
  line-height: 1;
}

.navLabel {
  flex: 1;
  min-width: 0;
  overflow:   hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Badges */

.badge {
  margin-left:   auto;
  border:        var(--border-width) solid var(--border-default);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-xs);
  padding:       1px 5px;
  font-family:   var(--font-mono);
  flex-shrink:   0;
}

.badgeDefault {
  color: var(--text-dim);
}

.badgeAlert {
  border-color: var(--border-glow-gold);
  color:        var(--neon-gold);
}
</file>

<file path="src/components/panels/SectorPositioningPanel.module.css">
/* ==========================================================================
   ORBIT · Component — SectorPositioningPanel.module.css
   Bloco 1 da aba Audiência: setor/nicho/funil + benchmarking
   Versão: 1.0.0  |  Data: 2026-08-31
   
   Alinhado 100% com TOKENS SSOT (src/lib/tokens.ts)
   ========================================================================== */

.panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-4);
  background-color: var(--bg2);
  border: 1px solid var(--line);
  border-radius: var(--r12);
  box-shadow: var(--shadow-glow-cyan);
  transition: all var(--transition-base);
}

.panel:hover {
  border-color: var(--border-glow-cyan);
  box-shadow: 0 0 30px rgba(0, 255, 255, 0.4);
}

/* ═══════════════════════════════════════════════════════════════
   TÍTULO DO PAINEL
   ═══════════════════════════════════════════════════════════════ */

.panelTitle {
  font-family: var(--font);
  font-size: var(--font-size-sm);
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--neon-cyan);
  text-transform: uppercase;
  margin: 0;
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--line);
}

/* ═══════════════════════════════════════════════════════════════
   LINHA DE INFORMAÇÕES (Setor + Funil)
   ═══════════════════════════════════════════════════════════════ */

.infoRow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

@media (max-width: 768px) {
  .infoRow {
    grid-template-columns: 1fr;
  }
}

.infoCard {
  padding: var(--space-3);
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.08) 0%, rgba(0, 255, 255, 0.04) 100%);
  border: 1px solid rgba(0, 255, 255, 0.15);
  border-radius: var(--r8);
  transition: all var(--transition-fast);
}

.infoCard:hover {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.12) 0%, rgba(0, 255, 255, 0.08) 100%);
  border-color: rgba(0, 255, 255, 0.3);
}

.infoLabel {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 500;
  color: var(--text-muted); /* FIX WCAG: era var(--t2), 3.21:1 sobre hover — falha AA. --text-muted já resolve para --t1 (8:1+) */
  text-transform: uppercase;
  letter-spacing: 0.03em;
  margin: 0 0 var(--space-2) 0;
}

.infoValue {
  font-family: var(--font);
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--t0);
  margin: 0 0 var(--space-1) 0;
  line-height: 1.3;
}

.infoSub {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  color: var(--t1);
  margin: var(--space-1) 0 0 0;
  line-height: 1.4;
}

/* ═══════════════════════════════════════════════════════════════
   LABEL DE BLOCO (BENCHMARKING)
   ═══════════════════════════════════════════════════════════════ */

.blockLabel {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--neon-cyan);
  text-transform: uppercase;
  margin: var(--space-4) 0 var(--space-3) 0;
  padding-top: var(--space-3);
  border-top: 1px solid var(--line);
}

/* ═══════════════════════════════════════════════════════════════
   GRID DE MÉTRICAS (ER Real, VPS, Score Polêmica)
   ═══════════════════════════════════════════════════════════════ */

.metricsRow {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

@media (max-width: 1024px) {
  .metricsRow {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .metricsRow {
    grid-template-columns: 1fr;
  }
}

.metricCard {
  padding: var(--space-3);
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r8);
  text-align: center;
  transition: all var(--transition-fast);
}

.metricCard:hover {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
  border-color: rgba(0, 255, 255, 0.3);
  transform: translateY(-2px);
}

.metricLabel {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 500;
  color: var(--text-muted); /* FIX WCAG: era var(--t2), 3.21:1 sobre hover — falha AA. --text-muted já resolve para --t1 (8:1+) */
  text-transform: uppercase;
  letter-spacing: 0.03em;
  margin: 0 0 var(--space-2) 0;
}

.metricValue {
  font-family: var(--mono);
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--neon-cyan);
  margin: 0 0 var(--space-2) 0;
  line-height: 1.2;
}

/* ═══════════════════════════════════════════════════════════════
   BADGES DE STATUS (Verde, Amarelo, Vermelho)
   ═══════════════════════════════════════════════════════════════ */

.badgeNeutral {
  display: inline-block;
  padding: var(--space-1) var(--space-2);
  border-radius: var(--r4);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 500;
  background-color: rgba(112, 110, 106, 0.2);
  color: var(--t1);
  border: 1px solid rgba(112, 110, 106, 0.3);
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.badgeWarning {
  display: inline-block;
  padding: var(--space-1) var(--space-2);
  border-radius: var(--r4);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  background-color: rgba(255, 176, 32, 0.15);
  color: var(--amber);
  border: 1px solid var(--amber);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  box-shadow: 0 0 10px rgba(255, 176, 32, 0.2);
}

.badgeDanger {
  display: inline-block;
  padding: var(--space-1) var(--space-2);
  border-radius: var(--r4);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  font-weight: 600;
  background-color: rgba(255, 68, 68, 0.15);
  color: var(--red);
  border: 1px solid var(--red);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  box-shadow: 0 0 10px rgba(255, 68, 68, 0.2);
}

/* ═══════════════════════════════════════════════════════════════
   TEXTO DE REGRA (Declaração de regra / threshold)
   ═══════════════════════════════════════════════════════════════ */

.ruleText {
  font-family: var(--font);
  font-size: var(--font-size-xs);
  color: var(--t1);
  padding: var(--space-3);
  padding-left: var(--space-4);
  border-left: 3px solid var(--neon-cyan);
  background-color: rgba(0, 255, 255, 0.05);
  border-radius: var(--r8);
  margin-top: var(--space-3);
  line-height: 1.6;
  font-style: italic;
}

.ruleText::before {
  content: "ℹ";
  display: inline-block;
  margin-right: var(--space-2);
  color: var(--neon-cyan);
  font-weight: 700;
  font-style: normal;
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVIDADE E ACESSIBILIDADE
   ═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  .panel,
  .infoCard,
  .metricCard {
    transition: none;
  }
}

/* Focus visible para acessibilidade */
.panel:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 2px;
}

.metricCard:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 1px;
}
</file>

<file path="src/components/screens/IGOverviewScreen.module.css">
.main {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: var(--space-6);
}

/* .section-head — título+subtítulo à esquerda, tabs à direita, mesma linha */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.titleBlock {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.title {
