<file path="src/components/common/RecommendationAlert.module.css">
/* RecommendationAlert.module.css
   Migrado de Tailwind (border-rose-500/60, bg-rose-950/40...) para tokens.
   Reaproveita o mesmo vocabulário de severidade de AlertCard/Semaphore
   (critical → --red, warning → --amber, healthy → --green) em vez de uma
   paleta própria (rose/amber/emerald do Tailwind), pra não criar uma quarta
   variação de "vermelho" no sistema.

   ✅ FIX: fundo/borda/glow do cartão inteiro agora vêm do <GlassCard> real
   (mesmo componente usado em AvatarComparison/AlignmentBars), com
   glowColor mapeado do status (critical→red, warning→gold, healthy→green).
   .wrapper deixou de desenhar border/background própria — só define
   --sev-color, usado pelos elementos internos (badge, ícone, headline). */

.wrapper {
  overflow: hidden;
  padding: 0 !important;
}

.critical { --sev-color: var(--red); }
.warning  { --sev-color: var(--amber); }
.healthy  { --sev-color: var(--green); }

.headerBtn {
  display:      flex;
  align-items:  center;
  gap:          var(--space-3);
  width:        100%;
  padding:      var(--space-4);
  text-align:   left;
  background:   transparent;
  border:       none;
  cursor:       pointer;
  transition:   background var(--transition-fast);
}

.headerBtn:hover {
  background: var(--bg-hover);
}

.iconBadge {
  display:         flex;
  align-items:     center;
  justify-content: center;
  flex-shrink:     0;
  width:           36px;
  height:          36px;
  border-radius:   var(--radius-md);
  background:      color-mix(in srgb, var(--sev-color) 20%, transparent);
  font-size:       var(--font-size-lg);
}

.headerText {
  flex:      1;
  min-width: 0;
}

.metaRow {
  display:      flex;
  align-items:  center;
  gap:          var(--space-2);
  flex-wrap:    wrap;
  margin-bottom: 2px;
}

.badge {
  font-family:    var(--font-family);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding:        1px 8px;
  border:         var(--border-width) solid color-mix(in srgb, var(--sev-color) 30%, transparent);
  border-radius:  var(--radius-sm);
  background:     color-mix(in srgb, var(--sev-color) 20%, transparent);
  color:          var(--sev-color);
}

.scoreText {
  font-family: var(--font-family);
  font-size:   var(--font-size-xs);
  color:       var(--text-muted);
}

.headline {
  font-family: var(--font-family);
  font-size:   var(--font-size-sm);
  font-weight: 600;
  color:       var(--sev-color);
}

.chevron {
  flex-shrink: 0;
  font-family: var(--font-family);
  font-size:   10px;
  color:       var(--text-muted);
}

.body {
  display:        flex;
  flex-direction: column;
  gap:            var(--space-2);
  padding:        0 var(--space-4) var(--space-4);
}

.divider {
  height:     1px;
  background: var(--border-default);
  margin-bottom: var(--space-1);
}

.item {
  display:        flex;
  gap:            var(--space-3);
  padding:        var(--space-3);
  border:         var(--border-width) solid var(--border-default);
  border-radius:  var(--radius-md);
  background:     var(--bg-hover);
}

.itemIcon {
  flex-shrink: 0;
  font-size:   var(--font-size-base);
  margin-top:  1px;
}

.itemTitle {
  font-family: var(--font-family);
  font-size:   var(--font-size-sm);
  font-weight: 600;
  color:       var(--text-secondary);
}

.itemDesc {
  font-family: var(--font-family);
  font-size:   var(--font-size-xs);
  line-height: 1.6;
  color:       var(--text-muted);
  margin-top:  2px;
}
</file>

<file path="src/components/common/StatusPill.module.css">
/* StatusPill.module.css */

.pill {
  display:        inline-block;
  border-radius:  var(--border-radius-sm);
  padding:        2px 8px;
  font-size:      var(--font-size-xs);
  font-family:    var(--font-family);
  font-weight:    var(--font-weight-bold);
  letter-spacing: 0.5px;
  white-space:    nowrap;
}

/* rgba(...) fixo trocado por color-mix() a partir do token — uma fonte só
   por cor, sem precisar redigitar o valor RGB do neon em cada regra. */

.cyan {
  background:  color-mix(in srgb, var(--neon-cyan) 10%, transparent);
  border:      var(--border-width) solid color-mix(in srgb, var(--neon-cyan) 40%, transparent);
  color:       var(--neon-cyan);
  text-shadow: 0 0 6px color-mix(in srgb, var(--neon-cyan) 40%, transparent);
}

.red {
  background:  color-mix(in srgb, var(--neon-red) 10%, transparent);
  border:      var(--border-width) solid color-mix(in srgb, var(--neon-red) 40%, transparent);
  color:       var(--neon-red);
  text-shadow: 0 0 6px color-mix(in srgb, var(--neon-red) 40%, transparent);
}

.gold {
  background:  color-mix(in srgb, var(--neon-gold) 10%, transparent);
  border:      var(--border-width) solid color-mix(in srgb, var(--neon-gold) 40%, transparent);
  color:       var(--neon-gold);
  text-shadow: 0 0 6px color-mix(in srgb, var(--neon-gold) 40%, transparent);
}

.green {
  background:  color-mix(in srgb, var(--neon-green) 10%, transparent);
  border:      var(--border-width) solid color-mix(in srgb, var(--neon-green) 40%, transparent);
  color:       var(--neon-green);
  text-shadow: 0 0 6px color-mix(in srgb, var(--neon-green) 40%, transparent);
}
</file>

<file path="src/components/content/CriticalAlert.module.css">
/* ============================================================================
   CriticalAlert.module.css — Refatoração 15/08/2026
   Todos os valores vêm de ssot-design-tokens.css (var(--token)). Nenhum
   :root local redeclarado — token duplicado era exatamente a causa da
   divergência de paleta entre este arquivo e AlertCard.module.css.
   4 classes de severidade porque AlertSeverity tem 4 valores reais
   (info|warning|critical|success) — ver orbit.ts.
   ============================================================================ */

.card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  border: var(--border-width) solid var(--line);
  border-radius: var(--r12);
  padding: var(--space-4) var(--space-5);
  width: 100%;
  background-color: var(--bg2);
  font-family: var(--font);
  transition: all var(--transition-fast);
}

.critical {
  background: linear-gradient(135deg, rgba(255, 68, 68, 0.08), transparent);
  border-color: var(--neon-red);
  box-shadow: var(--shadow-glow-red);
}

.warning {
  background: linear-gradient(135deg, rgba(255, 195, 0, 0.08), transparent);
  border-color: var(--neon-gold);
  box-shadow: var(--shadow-glow-gold);
}

.info {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.06), transparent);
  border-color: var(--neon-cyan);
  box-shadow: var(--shadow-glow-cyan);
}

.success {
  background: linear-gradient(135deg, rgba(46, 204, 113, 0.06), transparent);
  border-color: var(--green);
  /* EXTRAPOLADO: não existe --shadow-glow-green em ssot-design-tokens.css;
     valor abaixo segue o mesmo padrão (cor do estado, alpha 0.2) dos glows
     confirmados, mas não está no SSOT. */
  box-shadow: 0 0 20px rgba(46, 204, 113, 0.2);
}

.icon {
  font-size: var(--font-size-lg);
  flex-shrink: 0;
  margin-top: 1px;
}

.content {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--t0);
}

.body {
  font-size: var(--font-size-xs);
  color: var(--t1);
  line-height: var(--line-height-base);
}

.action {
  align-self: flex-start;
  margin-top: var(--space-2);
  padding: var(--space-1) var(--space-3);
  border: none;
  border-radius: var(--r4);
  background: transparent;
  color: var(--acc);
  font-family: var(--font);
  font-size: var(--font-size-xs);
  cursor: pointer;
  text-decoration: underline;
  transition: color var(--transition-fast);
}

.action:hover {
  color: var(--acc2-text); /* FIX WCAG: --acc2 puro é 4.17:1 sobre --bg2 (falha AA) */
}

.label {
  font-weight: var(--font-weight-bold);
  color: var(--t0);
}

.actionText {
  margin-top: var(--space-1);
  font-size: var(--font-size-xs);
  color: var(--t0);
  line-height: var(--line-height-base);
}
</file>

<file path="src/components/kpi/GlowingNumber.module.css">
/* GlowingNumber.module.css */

.wrapper {
  display:     inline-flex;
  align-items: baseline;
  gap:         var(--space-1);
}

.number {
  font-family:    var(--font-mono);
  font-weight:    var(--font-weight-bold);
  letter-spacing: -0.5px;
  line-height:    1;
}

/* Tamanhos */
.sizeSm { font-size: var(--font-size-xl);  }
.sizeMd { font-size: var(--font-size-2xl); }
.sizeLg { font-size: var(--font-size-3xl); }
.sizeXl { font-size: var(--font-size-4xl); }

/* Cores + glow */
.cyan {
  color:       var(--neon-cyan);
  text-shadow: 0 0 12px rgba(0, 255, 255, 0.6), 0 0 24px rgba(0, 255, 255, 0.2);
}

.red {
  color:       var(--neon-red);
  text-shadow: 0 0 12px rgba(255, 68, 68, 0.6), 0 0 24px rgba(255, 68, 68, 0.2);
}

.gold {
  color:       var(--neon-gold);
  text-shadow: 0 0 12px rgba(255, 195, 0, 0.6), 0 0 24px rgba(255, 195, 0, 0.2);
}

.green {
  color:       var(--neon-green);
  text-shadow: 0 0 12px rgba(46, 204, 113, 0.6), 0 0 24px rgba(46, 204, 113, 0.2);
}

.muted {
  color:       var(--text-muted);
  text-shadow: none;
}

/* Unidade */
.unit {
  font-size:   var(--font-size-xs);
  color:       var(--text-dim);
